---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HoursStrip from '../components/HoursStrip.astro';
import Pillars from '../components/Pillars.astro';
import Awards from '../components/Awards.astro';
import Spirits from '../components/Spirits.astro';
import ThisWeek from '../components/ThisWeek.astro';
import Experience from '../components/Experience.astro';
import Celebration from '../components/Celebration.astro';
import Mission from '../components/Mission.astro';
import EventCards from '../components/EventCards.astro';
import GiftHiring from '../components/GiftHiring.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Flying Ace Farm - Loudoun County’s First Farm Distillery & Brewery"
  description="Award-winning American Ace bourbon, craft beer and Monk’s BBQ on a 200-year-old working farm in Lovettsville, Virginia - with live music every Friday, Saturday and Sunday."
>
  <Header />

  <main id="main">
    <Hero />
    <HoursStrip />
    <Pillars />
    <Awards />
    <Spirits />
    <ThisWeek />
    <Experience />
    <Celebration />
    <Mission />
    <EventCards />
    <GiftHiring />
    <Newsletter />
  </main>

  <Footer />
</Base>
