---
import '../styles/global.css';
import AgeGate from '../components/AgeGate.astro';
import ActionBar from '../components/ActionBar.astro';

interface Props {
  title: string;
  description: string;
  /** For pages that exist to be arrived at, never to be found. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Social scrapers need an absolute URL, so the local poster is resolved
// against `site` from astro.config.mjs.
const ogImage = Astro.site
  ? new URL('images/hero-farm.jpg', Astro.site).href
  : '/images/hero-farm.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#18212C" />

    {/* The farm's roundel, on the navy it is drawn to sit on. The mark itself
        is light on nothing -- that is how it reads in the header -- so the
        tile behind it is what keeps it visible on a white tab strip as well
        as a dark one. The .ico is there for the bare /favicon.ico a browser
        asks for whether or not it is told to, and carries 16, 32 and 48. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Montserrat:wght@400;500;600&family=Newsreader:ital,opsz@1,6..72&family=Oswald:wght@500;600;700&display=swap"
    />

    <script is:inline>
      // Flagging JS before first paint means the reveal start-states apply
      // without a flash. No-JS visitors never get the flag, so they get the
      // full page. If the motion bundle fails to arrive, the timer below
      // drops the flag so no content is ever stranded at opacity 0.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        window.__motionFallback = window.setTimeout(function () {
          root.classList.remove('js');
        }, 2500);
      })();
    </script>
  </head>

  <body>
    <AgeGate />
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    {/* After the slot, so it is the last thing in the tab order rather than
        something a keyboard reader meets before the page. */}
    <ActionBar />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
