---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import EventPage from '../../components/EventPage.astro';
import Footer from '../../components/Footer.astro';
import { allShows } from '../../data/calendar';
import { artistProfiles } from '../../data/artists';

/* One page per show, all of them built ahead of time. The neighbours come
   from here rather than from the component, because only this file knows
   where the show sits in the season. */
export function getStaticPaths() {
  return allShows.map((show, i) => ({
    params: { slug: show.slug },
    props: { show, prev: allShows[i - 1], next: allShows[i + 1] },
  }));
}

const { show, prev, next } = Astro.props;
const profile = artistProfiles[show.artist];

const description = profile
  ? `${profile.billing}. ${show.weekday} ${show.day} ${show.month}, ${show.start} – ${show.end} at Flying Ace Farm in Lovettsville, Virginia. Free to attend, no ticket needed.`
  : `Live music at Flying Ace Farm, ${show.weekday} ${show.day} ${show.month}, ${show.start} – ${show.end}.`;
---

<Base title={`${show.artist} — Live Music at Flying Ace Farm`} description={description}>
  <Header />

  <main id="main">
    <EventPage show={show} prev={prev} next={next} />
  </main>

  <Footer />
</Base>
