---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import CocktailsHero from '../components/CocktailsHero.astro';
import CocktailList from '../components/CocktailList.astro';
import CocktailArchive from '../components/CocktailArchive.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Cocktail List - Flying Ace Farm Distillery | Lovettsville, VA"
  description="Every cocktail poured in the Flying Ace Farm distillery tasting room in Lovettsville, Virginia: thirteen on the board now, built on American Ace bourbon, whiskey and rum, and sixty two more poured before."
>
  <Header />

  <main id="main">
    <CocktailsHero />
    <CocktailList />
    <CocktailArchive />
  </main>

  <Footer />
</Base>
