---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import CalendarHero from '../components/CalendarHero.astro';
import EventList from '../components/EventList.astro';
import EventDetail from '../components/EventDetail.astro';
import Subscribe from '../components/Subscribe.astro';
import Footer from '../components/Footer.astro';
import { eventCount, season } from '../data/calendar';
---

<Base
  title="Calendar — Live Music at Flying Ace Farm | Lovettsville, VA"
  description={`Live music every Friday, Saturday and Sunday at Flying Ace Farm in Lovettsville, Virginia. ${eventCount} free shows booked through ${season} — see the full lineup and add it to your calendar.`}
>
  <Header />

  <main id="main">
    <CalendarHero />
    <EventList />
    <Subscribe />
  </main>

  {/* The follow-up detail for every show, opened from its card. Rendered into
      the page rather than split across 13 routes, so the bios ship in this
      page's HTML and a reader keeps their place in the lineup. */}
  <EventDetail />

  <Footer />
</Base>
