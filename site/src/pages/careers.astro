---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import CareersRoles from '../components/CareersRoles.astro';
import Mission from '../components/Mission.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Footer from '../components/Footer.astro';
import { careersHero as h } from '../data/connect';
---

<Base
  title="Careers — Flying Ace Farm | Lovettsville, VA"
  description="Flying Ace Farm is hiring distillery and brewery bartenders, kitchen staff, a kitchen shift leader and floor staff at its farm, restaurant and distillery in Lovettsville, Virginia."
>
  <Header />

  <main id="main">
    <PageHero
      eyebrow={h.eyebrow}
      title={h.title}
      lede={h.lede}
      cta={{ text: 'Apply Now', href: '#enquire' }}
    />
    <CareersRoles />
    {/* Why the farm exists, in its own words. An applicant reading this page
        is deciding whether to work here, and it is the clearest statement of
        what "here" is. */}
    <Mission />
    <EnquiryForm kind="careers" />
  </main>

  <Footer />
</Base>
