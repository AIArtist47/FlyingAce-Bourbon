---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import DistilleryHero from '../components/DistilleryHero.astro';
import HowToBuy from '../components/HowToBuy.astro';
import Lineup from '../components/Lineup.astro';
import HomegrownSpirits from '../components/HomegrownSpirits.astro';
import Cocktails from '../components/Cocktails.astro';
import TastingHours from '../components/TastingHours.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Flying Ace Farm Distillery - American Ace Spirits | Lovettsville, VA"
  description="Award-winning American Ace bourbon, whiskey and rum, distilled on a 200-year-old working farm in Lovettsville, Virginia. Shop the lineup, see the tasting room cocktails and plan your visit."
>
  <Header />

  <main id="main">
    <DistilleryHero />
    <HowToBuy />
    <Lineup />
    <HomegrownSpirits />
    <Cocktails />
    <TastingHours />
  </main>

  <Footer />
</Base>
