---
/**
 * Inline stroke icons, transcribed path-for-path from the Home-Desktop artboard.
 * `stroke` takes a CSS value so the colour comes from a token, not a hard-coded hex.
 */
interface Props {
  name:
    | 'clock'
    | 'bottle'
    | 'pin'
    | 'music'
    | 'medal'
    | 'calendar'
    | 'barn'
    | 'corn'
    | 'store'
    | 'flag'
    | 'gift'
    | 'menu'
    | 'close'
    | 'eye';
  size?: number;
  stroke?: string;
  width?: number;
  class?: string;
}

const {
  name,
  size = 24,
  stroke = 'var(--accent)',
  width = 1.6,
  class: className = '',
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={stroke}
  stroke-width={width}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
  {name === 'bottle' && <path d="M10 2h4v4l2 3v12a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V9l2-3z" />}
  {
    name === 'eye' && (
      <>
        <path d="M2 12s3.6-6.2 10-6.2S22 12 22 12s-3.6 6.2-10 6.2S2 12 2 12z" />
        <circle cx="12" cy="12" r="3" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
  {
    name === 'music' && (
      <>
        <path d="M9 18V5l11-2v13" />
        <circle cx="6" cy="18" r="3" />
        <circle cx="17" cy="16" r="3" />
      </>
    )
  }
  {
    name === 'medal' && (
      <>
        <circle cx="12" cy="15" r="6" />
        <path d="M8 3l4 6 4-6" />
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <rect x="4" y="5" width="16" height="15" rx="1" />
        <path d="M4 10h16M9 3v4M15 3v4" />
      </>
    )
  }
  {
    name === 'barn' && (
      <>
        <path d="M3 21V10l9-6 9 6v11z" />
        <path d="M9 21v-6h6v6" />
      </>
    )
  }
  {
    name === 'corn' && (
      <>
        <path d="M12 22V8" />
        <path d="M12 8c-3-1-4-4-4-6 3 1 4 3 4 6zM12 8c3-1 4-4 4-6-3 1-4 3-4 6z" />
        <path d="M12 14c-3-1-5-3-5-5 3 0 5 2 5 5zM12 14c3-1 5-3 5-5-3 0-5 2-5 5z" />
      </>
    )
  }
  {
    name === 'store' && (
      <>
        <path d="M4 10v10h16V10" />
        <path d="M3 10l2-6h14l2 6z" />
        <path d="M10 20v-5h4v5" />
      </>
    )
  }
  {name === 'flag' && <path d="M5 21V4h11l-2 4 2 4H5" />}
  {
    name === 'gift' && (
      <>
        <rect x="3" y="8" width="18" height="4" />
        <path d="M5 12v9h14v-9M12 8v13M12 8c-2-4-6-4-6-1s6 1 6 1zm0 0c2-4 6-4 6-1s-6 1-6 1z" />
      </>
    )
  }
  {name === 'menu' && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === 'close' && <path d="M5 5l14 14M19 5L5 19" />}
</svg>
