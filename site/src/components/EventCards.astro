---
import { eventCards } from '../data/site';

/**
 * Two photographs beside the cards, equal and side by side.
 *
 * Each answers to a card. Both sit at full strength at rest; hovering either
 * a card or its photograph lifts that one and darkens the other, so the pair
 * stays a comparison rather than becoming a slideshow.
 *
 * Decorative in full: every word this section carries is in the cards, so the
 * photographs take an empty alt and sit outside the accessibility tree.
 */
const G = '/images/gather';

/* One photograph per card, in the cards' own order, so the pair on the
   left reads left to right against the pair on the right. Decorative:
   every word this section carries is in the cards. */
const shots = eventCards.map((c) => ({ id: c.id, src: `${G}/${c.id}.webp` }));
---

<section class="ec" aria-label="Weddings and events">
  <div class="ec__inner wrap">
    <div class="ec__stage">
      <div class="ec__title">
        <h2 class="display ec__h2" data-reveal="up">Gather at the farm</h2>
        <p class="quote ec__sub" data-reveal="up">
          Eighty-six acres, two ways to take them over.
        </p>
      </div>

      {/* Hover is on the figure itself as well as on its card, so the
          gesture works whichever half of the section the pointer is in. */}
      <div class="ec__shots" aria-hidden="true">
        {
          shots.map((sh, i) => (
            <span class="ec__shot" data-shot={sh.id} data-reveal="up" data-stagger={i}>
              <img class="ec__shotimg" src={sh.src} alt="" loading="lazy" decoding="async" />
            </span>
          ))
        }
      </div>
    </div>

    {/* Right: two square cards, stacked. */}
    <div class="ec__cards">
      {
        eventCards.map((c, i) => (
          <article class="ec__card" id={c.id} data-card={c.id} data-reveal="up" data-stagger={i}>
            {/* The photograph again, inside the card, for touch screens where
                nothing ever hovers and the stage would stay empty. */}
            <img class="ec__inline" src={c.image} alt={c.alt} loading="lazy" decoding="async" />

            <div class="ec__copy">
              <p class="ec__kind">{c.eyebrow}</p>
              <h3 class="display display--700 ec__name">{c.title}</h3>
              <p class="ec__text">{c.body}</p>
            </div>

            <a class="ec__cta tap-box" href={c.href}>
              {c.cta} <span class="arrow-link__ico">&#8594;</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* A deliberately darker register than the navy sections elsewhere: near-black
     rather than #000, which goes flat and dead against photography. */
  .ec {
    /* How far the photograph that is not being asked about steps back. */
    --ec-dark: 0.42;

    --ec-black: #08090b;
    --ec-line: rgba(244, 238, 227, 0.16);
    --ec-text: #f4eee3;
    --ec-dim: rgba(244, 238, 227, 0.62);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ec-black);
    color: var(--ec-text);
    padding-block: var(--sec-y);
  }

  .ec__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    gap: 4rem;
    align-items: start;
  }

  /* --- Stage ------------------------------------------------------------ */

  /* Holds the heading and nothing else now: the collage is pinned to the
     section, not to this column. */
  .ec__stage {
    min-width: 0;
  }

  .ec__title {
    position: relative;
    z-index: 2;
    max-width: 30rem;
  }

  .ec__h2 {
    margin: 0;
    font-size: var(--t-h2);
    line-height: 0.95;
    color: var(--ec-text);
  }

  /* Family, italic and line-height come from .quote, the site's one italic
     treatment, the same way Celebration and Mission take it. Only size and
     colour are set here. */
  .ec__sub {
    margin: 1rem 0 0;
    font-size: var(--t-lead);
    color: var(--ec-dim);
  }

  .ec__cards {
    display: grid;
    gap: 1.5rem;
  }

  .ec__card {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid var(--ec-line);
    background: transparent;
    transition: background-color 0.45s var(--ease);
  }

  /* The border stays as it is on hover. The card lifts by filling slightly
     instead, so the feedback does not read as a highlighted outline. */
  .ec__card:hover {
    background-color: rgba(244, 238, 227, 0.045);
  }

  /* Shown only where there is no pointer to hover with. */
  .ec__inline {
    display: none;
  }

  .ec__copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .ec__kind {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--brass);
  }

  .ec__name {
    margin: 0;
    font-size: var(--t-34);
    line-height: 0.95;
    color: var(--ec-text);
  }

  .ec__text {
    margin: 0;
    max-width: 34ch;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--ec-dim);
  }

  .ec__cta {
    align-self: flex-start;
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--ec-text);
    text-decoration: none;
    border-bottom: 1px solid var(--ec-line);
    padding-bottom: 0.3125rem;
    transition:
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .ec__cta .arrow-link__ico {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }

  /* Brass on the call to action only. The card's own outline stays put on
     hover; it is the link that answers. */
  .ec__card:hover .ec__cta {
    color: var(--brass);
    border-bottom-color: var(--brass);
  }

  .ec__card:hover .ec__cta .arrow-link__ico {
    transform: translateX(0.25rem);
  }

  /* --- The two photographs ---------------------------------------------- */

  .ec__shots {
    position: relative;
    margin-top: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .ec__shot {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ec-black);
    border: 1px solid var(--ec-line);
    transition:
      transform 0.55s var(--ease),
      box-shadow 0.55s var(--ease);
  }

  .ec__shotimg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      filter 0.45s var(--ease),
      transform 0.8s var(--ease);
  }

  /* --- The tie between a card and its photograph ------------------------ */

  /* :has() drives this, the same mechanism the pillars accordion uses, so
     there is no script behind it. Both photographs sit at full strength until
     something is asked; then one rises and the other goes back, which reads
     as emphasis rather than as a slideshow changing slide.

     Either half of the section triggers it, the card or the photograph, so
     the pointer never has to find the right one. */
  @media (hover: hover) and (pointer: fine) {
    .ec__shot:hover,
    .ec:has([data-card='weddings']:hover) .ec__shot[data-shot='weddings'],
    .ec:has([data-card='private-events']:hover) .ec__shot[data-shot='private-events'] {
      transform: translateY(-0.875rem);
      box-shadow: 0 1.5rem 2.75rem rgba(0, 0, 0, 0.55);
      z-index: 2;
    }

    .ec__shot:hover .ec__shotimg {
      transform: scale(1.04);
    }

    /* And the other one steps back. Written as :not() against whichever is
       being asked about, so there is one rule per source of the hover rather
       than one per photograph. */
    .ec__shots:has(.ec__shot:hover) .ec__shot:not(:hover) .ec__shotimg,
    .ec:has([data-card='weddings']:hover) .ec__shot:not([data-shot='weddings']) .ec__shotimg,
    .ec:has([data-card='private-events']:hover) .ec__shot:not([data-shot='private-events']) .ec__shotimg {
      filter: brightness(var(--ec-dark));
    }
  }

  /* --- Narrow ----------------------------------------------------------- */

  @media (max-width: 68.75rem) {
    .ec__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .ec__card {
      aspect-ratio: auto;
      justify-content: flex-start;
      padding: 0 0 2rem;
      border: 0;
      border-bottom: 1px solid var(--ec-line);
    }

    .ec__card:hover {
      background: none;
    }

    /* The pair above the cards already carries the photography, so a copy
       inside each card would be this section's four pictures over again. */
    .ec__inline {
      display: none;
    }
  }

  /* The darkening stays: it is the emphasis, and it does not travel. The
     lift and the zoom go. */
  @media (prefers-reduced-motion: reduce) {
    .ec__shot,
    .ec__shotimg {
      transition-duration: 0.01ms;
    }

    .ec__shot:hover,
    .ec:has(.ec__card:hover) .ec__shot {
      transform: none;
    }

    .ec__shot:hover .ec__shotimg {
      transform: none;
    }
  }
</style>
