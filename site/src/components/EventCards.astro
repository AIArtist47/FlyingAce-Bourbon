---
import { eventCards } from '../data/site';
---

<section class="events section section--pad" aria-label="Weddings and events">
  <div class="wrap">
    <div class="grid-2">
      {
        eventCards.map((c, i) => (
          <article class="ev" id={c.id} data-reveal="up" data-stagger={i}>
            <span class="ev__media">
              <img class="ev__img" src={c.image} alt={c.alt} loading="lazy" />
            </span>
            <div class="ev__body">
              <p class="eyebrow">{c.eyebrow}</p>
              <h2 class="display ev__title">{c.title}</h2>
              <p class="ev__text">{c.body}</p>
              <a class="arrow-link" href={c.href}>
                {c.cta} <span class="arrow-link__ico">&#8594;</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ev {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule);
    transition:
      border-color 0.5s var(--ease),
      transform 0.6s var(--ease);
  }

  .ev:hover {
    border-color: var(--accent);
    transform: translateY(-0.375rem);
  }

  .ev__media {
    display: block;
    overflow: hidden;
    background: var(--sand);
  }

  .ev__img {
    width: 100%;
    height: 22.5rem; /* 360px */
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .ev:hover .ev__img {
    transform: scale(1.05);
  }

  .ev__body {
    padding: 2.25rem; /* 36px */
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .ev__title {
    font-size: var(--t-44);
    line-height: var(--lh-display);
  }

  .ev__text {
    font-size: var(--t-16);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .ev__img {
      height: 15rem;
    }
    .ev__body {
      padding: 1.5rem;
    }
  }
</style>
