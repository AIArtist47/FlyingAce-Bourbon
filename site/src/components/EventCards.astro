---
import { eventCards } from '../data/site';

/* Stage order matches card order, so :has() can tie a card to its own shot. */
const shots = eventCards.map((c) => ({ id: c.id, image: c.image, alt: c.alt }));
---

<section class="ec" aria-label="Weddings and events">
  {/* Sits on the section itself, not inside the inner column, so the
      photograph bleeds to the section's own edges rather than stopping at
      the gutter. Black until a card is hovered, then that card's shot fades
      up and masks back into the black before it reaches them. */}
  <div class="ec__shots" aria-hidden="true">
    {
      shots.map((s) => (
        <img class="ec__shot" data-shot={s.id} src={s.image} alt="" loading="lazy" decoding="async" />
      ))
    }
  </div>

  <div class="ec__inner wrap">
    <div class="ec__stage">
      <div class="ec__title">
        <h2 class="display ec__h2" data-reveal="up">Gather at the farm</h2>
        <p class="ec__sub" data-reveal="up">Two hundred acres, two ways to take them over.</p>
      </div>
    </div>

    {/* Right: two square cards, stacked. */}
    <div class="ec__cards">
      {
        eventCards.map((c, i) => (
          <article class="ec__card" id={c.id} data-card={c.id} data-reveal="up" data-stagger={i}>
            {/* The photograph again, inside the card, for touch screens where
                nothing ever hovers and the stage would stay empty. */}
            <img class="ec__inline" src={c.image} alt={c.alt} loading="lazy" decoding="async" />

            <div class="ec__copy">
              <p class="ec__kind">{c.eyebrow}</p>
              <h3 class="display display--700 ec__name">{c.title}</h3>
              <p class="ec__text">{c.body}</p>
            </div>

            <a class="ec__cta" href={c.href}>
              {c.cta} <span class="arrow-link__ico">&#8594;</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* A deliberately darker register than the navy sections elsewhere: near-black
     rather than #000, which goes flat and dead against photography. */
  .ec {
    --ec-black: #08090b;
    --ec-line: rgba(244, 238, 227, 0.16);
    --ec-text: #f4eee3;
    --ec-dim: rgba(244, 238, 227, 0.62);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ec-black);
    color: var(--ec-text);
    padding-block: var(--sec-y);
  }

  .ec__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    gap: 4rem;
    align-items: start;
  }

  /* --- Stage ------------------------------------------------------------ */

  .ec__stage {
    position: relative;
    align-self: stretch;
    min-height: 100%;
    overflow: hidden;
  }

  .ec__title {
    position: relative;
    z-index: 2;
    max-width: 30rem;
  }

  .ec__h2 {
    margin: 0;
    font-size: var(--t-h2);
    line-height: 0.95;
    color: var(--ec-text);
  }

  .ec__sub {
    margin: 1rem 0 0;
    font-size: var(--t-17);
    line-height: var(--lh-body);
    color: var(--ec-dim);
  }

  /* Pinned to the section box, padding included, so the picture reaches every
     edge of the section rather than the inner column's. */
  .ec__shots {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Keeps the heading readable over whichever photograph is up. */
  .ec__shots::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--ec-black) 0%,
      rgba(8, 9, 11, 0.7) 22%,
      rgba(8, 9, 11, 0) 52%
    );
  }

  .ec__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* The blend: the photograph dissolves to nothing before it reaches the
       cards, so there is no edge to see. A mask rather than a dark overlay,
       because an overlay only darkens the picture while a mask actually lets
       the black through. Measured across the full section now, so the stops
       land earlier than when it was confined to the left column: the cards
       begin around 63% across at every width the grid holds. */
    -webkit-mask-image: linear-gradient(100deg, #000 0%, #000 32%, transparent 66%);
    mask-image: linear-gradient(100deg, #000 0%, #000 32%, transparent 66%);
    transition: opacity 0.65s var(--ease);
    will-change: opacity;
  }

  /* --- Cards ------------------------------------------------------------ */

  .ec__cards {
    display: grid;
    gap: 1.5rem;
  }

  .ec__card {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid var(--ec-line);
    background: transparent;
    transition: background-color 0.45s var(--ease);
  }

  /* The border stays as it is on hover. The card lifts by filling slightly
     instead, so the feedback does not read as a highlighted outline. */
  .ec__card:hover {
    background-color: rgba(244, 238, 227, 0.045);
  }

  /* Shown only where there is no pointer to hover with. */
  .ec__inline {
    display: none;
  }

  .ec__copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .ec__kind {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .ec__name {
    margin: 0;
    font-size: var(--t-34);
    line-height: 0.95;
    color: var(--ec-text);
  }

  .ec__text {
    margin: 0;
    max-width: 34ch;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--ec-dim);
  }

  .ec__cta {
    align-self: flex-start;
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ec-text);
    text-decoration: none;
    border-bottom: 1px solid var(--ec-line);
    padding-bottom: 0.3125rem;
    transition:
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .ec__cta .arrow-link__ico {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }

  /* Cream rather than brass: nothing on the card should pick up a yellow
     stroke on hover. The underline brightening is enough feedback. */
  .ec__card:hover .ec__cta {
    border-bottom-color: var(--ec-text);
  }

  .ec__card:hover .ec__cta .arrow-link__ico {
    transform: translateX(0.25rem);
  }

  /* --- The tie between a card and its photograph ------------------------ */

  /* :has() drives the whole reveal, the same mechanism the pillars accordion
     already uses. No script, so nothing to fall out of sync. */
  @media (hover: hover) and (pointer: fine) {
    /* Scoped to the section now rather than the inner column, since the shots
       are no longer inside it. */
    .ec:has([data-card='weddings']:hover) .ec__shot[data-shot='weddings'],
    .ec:has([data-card='private-events']:hover) .ec__shot[data-shot='private-events'] {
      opacity: 1;
    }
  }

  /* --- Narrow ----------------------------------------------------------- */

  @media (max-width: 68.75rem) {
    .ec__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    /* The stage has no hover to respond to, so it keeps the heading and drops
       the photographs; each card carries its own instead. */
    .ec__stage {
      min-height: 0;
    }

    .ec__shots {
      display: none;
    }

    .ec__card {
      aspect-ratio: auto;
      justify-content: flex-start;
      padding: 0 0 2rem;
      border: 0;
      border-bottom: 1px solid var(--ec-line);
    }

    .ec__card:hover {
      background: none;
    }

    .ec__inline {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      margin-bottom: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ec__shot {
      transition-duration: 0.01ms;
    }
  }
</style>
