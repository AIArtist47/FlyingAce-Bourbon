---
import { eventCards } from '../data/site';

/* Stage order matches card order, so :has() can tie a card to its own shot. */
const shots = eventCards.map((c) => ({ id: c.id, image: c.image, alt: c.alt }));
---

<section class="ec" aria-label="Weddings and events" data-ec>
  {/* Sits on the section itself, not inside the inner column, so the
      photograph bleeds to the section's own edges rather than stopping at
      the gutter. Black until a card is hovered, then that card's shot fades
      up and masks back into the black before it reaches them. */}
  <div class="ec__shots" aria-hidden="true">
    {
      shots.map((s) => (
        <img class="ec__shot" data-shot={s.id} src={s.image} alt="" loading="lazy" decoding="async" />
      ))
    }
  </div>

  <div class="ec__inner wrap">
    <div class="ec__stage">
      <div class="ec__title">
        <h2 class="display ec__h2" data-reveal="up">Gather at the farm</h2>
        <p class="quote ec__sub" data-reveal="up">
          Two hundred acres, two ways to take them over.
        </p>
      </div>
    </div>

    {/* Right: two square cards, stacked. */}
    <div class="ec__cards">
      {
        eventCards.map((c, i) => (
          <article class="ec__card" id={c.id} data-card={c.id} data-reveal="up" data-stagger={i}>
            {/* The photograph again, inside the card, for touch screens where
                nothing ever hovers and the stage would stay empty. */}
            <img class="ec__inline" src={c.image} alt={c.alt} loading="lazy" decoding="async" />

            <div class="ec__copy">
              <p class="ec__kind">{c.eyebrow}</p>
              <h3 class="display display--700 ec__name">{c.title}</h3>
              <p class="ec__text">{c.body}</p>
            </div>

            <a class="ec__cta" href={c.href}>
              {c.cta} <span class="arrow-link__ico">&#8594;</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* A deliberately darker register than the navy sections elsewhere: near-black
     rather than #000, which goes flat and dead against photography. */
  .ec {
    /* How far up the two photographs sit together before anything is hovered.
       Low enough that the stage still reads as black with something behind it
       rather than as a picture. */
    --ec-rest: 0.3;

    --ec-black: #08090b;
    --ec-line: rgba(244, 238, 227, 0.16);
    --ec-text: #f4eee3;
    --ec-dim: rgba(244, 238, 227, 0.62);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ec-black);
    color: var(--ec-text);
    padding-block: var(--sec-y);
  }

  .ec__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    gap: 4rem;
    align-items: start;
  }

  /* --- Stage ------------------------------------------------------------ */

  .ec__stage {
    position: relative;
    align-self: stretch;
    min-height: 100%;
    overflow: hidden;
  }

  .ec__title {
    position: relative;
    z-index: 2;
    max-width: 30rem;
  }

  .ec__h2 {
    margin: 0;
    font-size: var(--t-h2);
    line-height: 0.95;
    color: var(--ec-text);
  }

  /* Family, italic and line-height come from .quote, the site's one italic
     treatment, the same way Celebration and Mission take it. Only size and
     colour are set here. */
  .ec__sub {
    margin: 1rem 0 0;
    font-size: var(--t-lead);
    color: var(--ec-dim);
  }

  /* Pinned to the section box, padding included, so the picture reaches every
     edge of the section rather than the inner column's. */
  .ec__shots {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Black down the join, so the two bands meet the section's own colour
     rather than cutting into each other. Only while they are side by side --
     once one photograph opens out there is no seam to cover. Sits above the
     shots and below the heading scrim. */
  .ec__shots::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      100deg,
      rgba(8, 9, 11, 0) 23%,
      var(--ec-black) 30%,
      var(--ec-black) 35%,
      rgba(8, 9, 11, 0) 42%
    );
    transition: opacity 0.55s var(--ease);
  }

  .ec[data-in-view='true']:not(:has(.ec__card:hover)) .ec__shots::before {
    opacity: 1;
  }

  /* Keeps the heading readable over whichever photograph is up. */
  .ec__shots::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--ec-black) 0%,
      rgba(8, 9, 11, 0.7) 22%,
      rgba(8, 9, 11, 0) 52%
    );
  }

  .ec__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* The blend: the photograph dissolves to nothing before it reaches the
       cards, so there is no edge to see. A mask rather than a dark overlay,
       because an overlay only darkens the picture while a mask actually lets
       the black through. Measured across the full section now, so the stops
       land earlier than when it was confined to the left column: the cards
       begin around 63% across at every width the grid holds. */
    -webkit-mask-image: linear-gradient(100deg, #000 0%, #000 46%, transparent 68%);
    mask-image: linear-gradient(100deg, #000 0%, #000 46%, transparent 68%);
    /* Full frame unless the resting split below narrows it. Both properties
       move together on the same curve, so opening out of the pair into one
       picture is a single gesture rather than a fade and a wipe arriving at
       different times. */
    clip-path: inset(0);
    transition:
      opacity 0.55s var(--ease),
      clip-path 0.55s var(--ease);
    will-change: opacity, clip-path;
  }

  /* --- Cards ------------------------------------------------------------ */

  .ec__cards {
    display: grid;
    gap: 1.5rem;
  }

  .ec__card {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 2rem;
    border: 1px solid var(--ec-line);
    background: transparent;
    transition: background-color 0.45s var(--ease);
  }

  /* The border stays as it is on hover. The card lifts by filling slightly
     instead, so the feedback does not read as a highlighted outline. */
  .ec__card:hover {
    background-color: rgba(244, 238, 227, 0.045);
  }

  /* Shown only where there is no pointer to hover with. */
  .ec__inline {
    display: none;
  }

  .ec__copy {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .ec__kind {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--brass);
  }

  .ec__name {
    margin: 0;
    font-size: var(--t-34);
    line-height: 0.95;
    color: var(--ec-text);
  }

  .ec__text {
    margin: 0;
    max-width: 34ch;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--ec-dim);
  }

  .ec__cta {
    align-self: flex-start;
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--ec-text);
    text-decoration: none;
    border-bottom: 1px solid var(--ec-line);
    padding-bottom: 0.3125rem;
    transition:
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .ec__cta .arrow-link__ico {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }

  /* Brass on the call to action only. The card's own outline stays put on
     hover; it is the link that answers. */
  .ec__card:hover .ec__cta {
    color: var(--brass);
    border-bottom-color: var(--brass);
  }

  .ec__card:hover .ec__cta .arrow-link__ico {
    transform: translateX(0.25rem);
  }

  /* Before anything is hovered, both photographs sit up together -- a double
     exposure of what the two cards hold, rather than flat black. It arrives
     with the section rather than being there from the start.

     Written as :not(:has(...)) so that hovering simply stops it matching: the
     base opacity: 0 comes back for both, and the rule below lifts the hovered
     one on its own. Nothing here competes with it, so the behaviour that was
     already defined is untouched. */
  .ec[data-in-view='true']:not(:has(.ec__card:hover)) .ec__shot {
    opacity: var(--ec-rest);
  }

  /* Side by side rather than stacked: each photograph takes its own band, with
     a slice of black between them so the seam is the section's own colour and
     not one picture cutting into the other. The right-hand band runs into the
     gradient's fade, which is what carries the pair off toward the cards. */
  .ec[data-in-view='true']:not(:has(.ec__card:hover)) .ec__shot[data-shot='weddings'] {
    clip-path: inset(0 66% 0 0);
  }

  .ec[data-in-view='true']:not(:has(.ec__card:hover))
    .ec__shot[data-shot='private-events'] {
    clip-path: inset(0 36% 0 30%);
  }

  /* --- The tie between a card and its photograph ------------------------ */

  /* :has() drives the reveal itself, the same mechanism the pillars accordion
     already uses -- the one line of script below only says when the section
     has arrived, and never touches which photograph is up. */
  @media (hover: hover) and (pointer: fine) {
    /* Scoped to the section now rather than the inner column, since the shots
       are no longer inside it. */
    .ec:has([data-card='weddings']:hover) .ec__shot[data-shot='weddings'],
    .ec:has([data-card='private-events']:hover) .ec__shot[data-shot='private-events'] {
      opacity: 1;
    }
  }

  /* --- Narrow ----------------------------------------------------------- */

  @media (max-width: 68.75rem) {
    .ec__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    /* The stage has no hover to respond to, so it keeps the heading and drops
       the photographs; each card carries its own instead. */
    .ec__stage {
      min-height: 0;
    }

    .ec__shots {
      display: none;
    }

    .ec__card {
      aspect-ratio: auto;
      justify-content: flex-start;
      padding: 0 0 2rem;
      border: 0;
      border-bottom: 1px solid var(--ec-line);
    }

    .ec__card:hover {
      background: none;
    }

    .ec__inline {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      margin-bottom: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ec__shot,
    .ec__shots::before {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  /* Flags the section once it has been seen, which is all the resting blend
     needs. Latched rather than live: it should settle in and stay, not fade
     back out every time the section leaves the window. */
  const ec = document.querySelector<HTMLElement>('[data-ec]');

  if (ec && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          ec.dataset.inView = 'true';
          io.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    io.observe(ec);
  } else {
    /* No observer, no fade-in -- but the blend itself still belongs there. */
    ec?.setAttribute('data-in-view', 'true');
  }
</script>
