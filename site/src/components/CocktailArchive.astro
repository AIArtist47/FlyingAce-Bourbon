---
import { standby } from '../data/cocktails';

/**
 * Everything the room has poured before.
 *
 * Sixty two drinks. No photographs, and that is the point rather than a
 * shortcut: this is a record, not a menu, and nobody scrolls sixty two
 * pictures of a drink they cannot order. Names and builds, set in columns so
 * the whole range can be taken in at once.
 */
---

<section class="cka section section--pad" id="before">
  <div class="wrap">
    <p class="eyebrow eyebrow--brass" data-reveal="up">On standby</p>
    <h2 class="display cka__h2" data-reveal="up">Poured before</h2>
    <p class="cka__note" data-reveal="up">
      What the still has turned out across the seasons. Ask &mdash; the bar can often bring one back.
    </p>

    <ul class="cka__grid" role="list">
      {
        standby.map((c) => (
          <li class="cka__item">
            <h3 class="display cka__name">{c.title}</h3>
            <p class="cka__build">{c.build}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cka {
    background: var(--navy);
    color: var(--cream);
  }

  .cka__h2 {
    font-size: var(--t-h2-sm);
    margin: var(--gap-eyebrow) 0 0;
    color: var(--cream);
  }

  .cka__note {
    margin: 0.75rem 0 0;
    font-family: var(--font-sub);
    font-size: var(--t-body-sm);
    line-height: var(--lh-body);
    color: var(--on-navy);
    max-width: 48ch;
  }

  /* Columns rather than one long run: sixty two stacked entries is a scroll,
     three abreast is a list you can read. A rule over each, not around each
     -- sixty two boxes would be a wall. */
  .cka__grid {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem clamp(1.5rem, 3vw, 2.75rem);
  }

  .cka__item {
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-navy);
  }

  .cka__name {
    margin: 0;
    font-size: var(--t-22);
    line-height: var(--lh-card);
    color: var(--cream);
  }

  .cka__build {
    margin: 0.375rem 0 0;
    font-family: var(--font-sub);
    font-size: var(--t-14);
    line-height: var(--lh-body);
    color: var(--on-navy-2);
  }

  @media (max-width: 64rem) {
    .cka__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .cka__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
