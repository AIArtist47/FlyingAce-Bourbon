---
import { cocktails } from '../data/distillery';
---

<section class="ck section section--pad" id="cocktails" aria-labelledby="ck-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">On the runway · now featured</p>
        <h2 class="display ck__h2" id="ck-title" data-reveal="up">Tasting room cocktails</h2>
      </div>
      <a
        class="arrow-link"
        href="https://flyingacefarm.com/spirits-cocktails/"
        target="_blank"
        rel="noopener"
        data-reveal="up"
      >
        Full cocktail list <span class="arrow-link__ico">&#8594;</span>
      </a>
    </div>

    <div class="ck__grid">
      {
        cocktails.map((c, i) => (
          <figure class="pour" data-reveal="up" data-stagger={i % 4}>
            <span class="pour__media">
              <img class="pour__img" src={c.image} alt={c.name} loading="lazy" />
            </span>
            <figcaption class="pour__body">
              <h3 class="pour__name display display--700">{c.name}</h3>
              <p class="pour__build">{c.build}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ck__h2 {
    font-size: var(--t-h2);
  }

  .ck__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1.5rem;
  }

  .pour {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
  }

  .pour__media {
    display: block;
    overflow: hidden;
    background: var(--sand);
  }

  .pour__img {
    width: 100%;
    height: 16.25rem; /* 260px */
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .pour:hover .pour__img {
    transform: scale(1.06);
  }

  .pour__body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .pour__name {
    font-size: var(--t-24);
    line-height: 1;
    margin: 0;
    transition: color 0.35s var(--ease);
  }

  .pour:hover .pour__name {
    color: var(--accent);
  }

  .pour__build {
    margin: 0;
    font-size: var(--t-14);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 68.75rem) {
    .ck__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .ck__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .pour__img {
      height: 14rem;
    }
  }
</style>
