---
import Icon from './Icon.astro';
import { experience } from '../data/site';
---

<section class="exp section section--pad on-navy" id="visit" aria-labelledby="exp-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow eyebrow--brass" data-reveal="up">The experience</p>
        <h2 class="display exp__h2" id="exp-title" data-reveal="up">
          Farm-to-table. Farm-to-bottle.
        </h2>
      </div>
      <p class="quote exp__quote" data-reveal="up">
        At the base of Furnace Mountain, near the Potomac River.
      </p>
    </div>

    <div class="exp__grid">
      {
        experience.map((e, i) => (
          <div class="fact" data-reveal="up" data-stagger={i}>
            <Icon name={e.icon as any} size={30} stroke="var(--brass)" width={1.5} />
            <h3 class="fact__title display display--700">{e.title}</h3>
            <p class="fact__body">{e.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exp {
    background: var(--navy);
    color: var(--cream);
  }

  .exp__h2 {
    font-size: var(--t-h2);
  }

  .exp__quote {
    font-size: var(--t-22);
    color: var(--on-navy);
    max-width: 23.75rem; /* 380px */
  }

  .exp__grid {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-top: 1px solid var(--rule-navy);
    padding-top: 1.5rem;
    min-width: 0;
    transition: border-color 0.5s var(--ease);
  }

  .fact:hover {
    border-color: var(--brass);
  }

  .fact__title {
    font-size: var(--t-28);
  }

  .fact__body {
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--on-navy-2);
  }

  @media (max-width: 68.75rem) {
    .exp__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .exp__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.5rem;
    }
  }
</style>
