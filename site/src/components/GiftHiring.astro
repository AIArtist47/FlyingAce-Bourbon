---
import Icon from './Icon.astro';

const tiles = [
  {
    icon: 'gift',
    title: 'Gift Cards',
    body: 'Good at our brewery, distillery, restaurant and on-site ABC store.',
    cta: 'Buy a Gift Card',
    href: 'https://flyingacefarm.com/gift-cards/',
  },
  {
    icon: 'barn',
    title: 'We’re Hiring',
    body: 'Brewery & distillery bartenders, kitchen staff, front of house and more.',
    cta: 'Apply Now',
    href: 'https://flyingacefarm.com/apply-now/',
  },
] as const;
---

<section class="gh" aria-label="Gift cards and careers">
  <div class="wrap">
    <div class="grid-2">
      {
        tiles.map((t, i) => (
          <div class="tile" data-reveal="up" data-stagger={i}>
            <Icon name={t.icon} size={40} width={1.4} />
            <div class="tile__text">
              <h2 class="display tile__title">{t.title}</h2>
              <p class="tile__body">{t.body}</p>
            </div>
            <a class="btn btn--ghost btn--md" href={t.href}>
              {t.cta}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gh {
    padding-bottom: var(--sec-y);
  }

  .tile {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 2rem 2.25rem;
    transition: border-color 0.5s var(--ease);
  }

  .tile:hover {
    border-color: var(--accent);
  }

  .tile > :global(svg) {
    flex-shrink: 0;
  }

  .tile__text {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .tile__title {
    font-size: var(--t-34);
  }

  .tile__body {
    font-size: var(--t-15);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 48rem) {
    .tile {
      flex-wrap: wrap;
      gap: 1.25rem;
    }
    .tile__text {
      flex-basis: 100%;
      order: 2;
    }
    .tile > :global(a) {
      order: 3;
    }
  }
</style>
