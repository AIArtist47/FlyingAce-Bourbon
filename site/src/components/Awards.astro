---
import Icon from './Icon.astro';
import { awards } from '../data/site';
---

<section class="awards" aria-label="Awards">
  <div class="awards__inner wrap">
    {
      awards.map((a, i) => (
        <div class="awards__item" data-reveal="up" data-stagger={i}>
          <Icon name="medal" size={34} stroke="var(--award)" width={1.5} />
          <div class="awards__text">
            <p class="awards__medal display">{a.medal}</p>
            <p class="awards__comp">{a.comp}</p>
            <p class="awards__product">{a.product}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .awards {
    background: var(--sand);
  }

  .awards__inner {
    min-height: 12.5rem; /* 200px */
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    padding-block: 2.5rem;
  }

  .awards__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .awards__item > :global(svg) {
    flex-shrink: 0;
  }

  .awards__text {
    min-width: 0;
  }

  .awards__medal {
    font-size: var(--t-26);
    line-height: 1;
  }

  .awards__comp {
    font-size: var(--t-13);
    line-height: 1.5;
    color: var(--muted);
    margin-top: 0.375rem;
  }

  .awards__product {
    font-size: var(--t-13);
    font-weight: 600;
    margin-top: 0.125rem;
    line-height: 1.5;
  }

  @media (max-width: 68.75rem) {
    .awards__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 36rem) {
    .awards__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
