---
import { site, img, restaurantHours, distilleryHours, exploreLinks, social } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

<footer class="ft on-navy">
  <div class="ft__inner wrap">
    <div class="ft__cols">
      <div class="ft__brand" data-reveal="up">
        {/* Same lockup as the header, so it goes to the same place. The
            address and socials stay outside it — they are not "home", and a
            social link nested inside another link would not be valid. */}
        <a class="ft__home" href="/" rel="home" aria-label={`${site.name} — home`} data-home>
          <img class="ft__mark" src={img.logo} alt="" width="56" height="56" loading="lazy" />
          <span class="ft__name display">Flying Ace Farm</span>
        </a>
        <p class="ft__addr">
          {site.street}<br />
          {site.cityState}<br />
          <a class="ft__phone tap-box" href={site.phoneHref}>{site.phone}</a>
        </p>
        <ul class="ft__social">
          {
            social.map((s) => (
              <li>
                <a class="ft__soc" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                  <SocialIcon name={s.icon} size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal="up" data-stagger="1">
        <p class="kicker ft__kicker">Restaurant &amp; Brewery</p>
        <dl class="ft__hours">
          {
            restaurantHours.map((h) => (
              <div class="ft__row">
                <dt>{h.day}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div data-reveal="up" data-stagger="2">
        <p class="kicker ft__kicker">Distillery &amp; ABC Store</p>
        <dl class="ft__hours">
          {
            distilleryHours.map((h) => (
              <div class="ft__row">
                <dt>{h.day}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <nav class="ft__explore" aria-label="Explore" data-reveal="up" data-stagger="3">
        <p class="kicker ft__kicker">Explore</p>
        {
          exploreLinks.map((l) => (
            <a class="ft__link tap-box" href={l.href}>
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="ft__legal">
      <p class="ft__copy">
        © 2026 Flying Ace Farm · You must be 21+ to purchase alcohol. Please drink responsibly.
      </p>
      <p class="ft__meta">
        <span>ACSA Member</span>
        <span class="ft__powered">
          Powered by <a class="ft__by tap-strip" href="#">Sipn Enterprises Inc.</a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--navy);
    color: var(--on-navy);
  }

  .ft__inner {
    min-height: 28.75rem; /* 460px */
    padding-top: 4.5rem; /* 72px */
    padding-bottom: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
  }

  .ft__cols {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 0.8fr;
    gap: 3rem;
    font-size: var(--t-14);
    line-height: var(--lh-body);
  }

  .ft__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  /* Carries the spacing the mark and wordmark had before they were wrapped. */
  .ft__home {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    color: var(--cream);
  }

  .ft__home:hover {
    color: var(--brass);
  }

  .ft__mark {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    transition: transform 0.5s var(--ease);
  }

  /* Mirrors the header lockup's tilt on hover. */
  .ft__home:hover .ft__mark {
    transform: rotate(-8deg) scale(1.05);
  }

  .ft__name {
    font-size: var(--t-28);
    letter-spacing: var(--ls-display);
    color: inherit;
    transition: color 0.35s var(--ease);
  }

  .ft__addr {
    margin: 0;
  }

  .ft__phone {
    color: var(--cream);
    font-weight: 600;
  }

  .ft__phone:hover {
    color: var(--brass);
  }

  .ft__social {
    list-style: none;
    display: flex;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  /* Unstroked, so the marks read as marks rather than as boxed buttons. The
     square is kept as the layout and hit area -- the three sit on an even
     rhythm however wide each glyph happens to be, and every target clears
     44px -- and only becomes visible on hover. */
  .ft__soc {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--brass);
    transition:
      color 0.35s var(--ease),
      background-color 0.35s var(--ease);
  }

  .ft__soc:hover {
    color: var(--navy);
    background-color: var(--brass);
  }

  .ft__kicker {
    margin: 0 0 0.5rem;
  }

  .ft__hours {
    margin: 0;
  }

  .ft__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule-navy);
  }

  .ft__row dt {
    margin: 0;
  }

  .ft__row dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .ft__explore {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    align-items: flex-start;
  }

  .ft__link {
    color: var(--on-navy);
  }

  .ft__link:hover {
    color: var(--brass);
  }

  .ft__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--rule-navy);
    padding-top: 1.375rem;
    /* 0.875rem is the floor for small UI text; 13px sat under it. */
    font-size: var(--t-14);
    color: var(--on-navy-3);
  }

  .ft__copy,
  .ft__meta {
    margin: 0;
  }

  .ft__meta {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .ft__powered {
    color: var(--on-navy);
  }

  .ft__by {
    color: var(--brass);
    font-weight: 600;
  }

  .ft__by:hover {
    color: var(--cream);
  }

  @media (max-width: 68.75rem) {
    .ft__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  @media (max-width: 36rem) {
    .ft__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The seven explore links sat at a 28px pitch -- 22px of link and 6px of
     gap -- which is one thumb across two of them. Standing each one up to
     44px is the spacing: the gap goes, because the links now carry it
     themselves, and the column grows by about a thumb's width in total. */
  @media (hover: none) and (pointer: coarse) {
    .ft__explore {
      gap: 0;
      /* The links are as wide as their words -- "Blog" was 30px across. On a
         phone the row is what a thumb aims at, so the link becomes the row. */
      align-items: stretch;
    }
  }
</style>
