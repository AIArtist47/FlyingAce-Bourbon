---
import { breweryHero as h } from '../data/brewery';
---

<section class="bhero on-navy" id="top">
  <div class="bhero__inner wrap">
    <div class="bhero__copy">
      <p class="eyebrow eyebrow--brass" data-reveal="up">{h.eyebrow}</p>
      <h1 class="display bhero__title" data-reveal="up">{h.title}</h1>
      <p class="bhero__lede" data-reveal="up">{h.lede}</p>
      <div class="bhero__cta" data-reveal="up">
        <a class="btn btn--solid btn--lg" href="#draft">See the Draft List</a>
        <a class="btn btn--ghost-light btn--lg" href="#to-go">Beer To Go</a>
      </div>
    </div>

    <!-- No data-parallax here: the parallax overscales by 1.16 to keep its own
         edges hidden, which would crop the tanks back out. Same as the
         distillery hero. -->
    <div class="bhero__media" data-reveal="up">
      <img
        class="bhero__img"
        src={h.image}
        alt={h.alt}
        width="2560"
        height="1707"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .bhero {
    background: var(--navy);
    color: var(--cream);
  }

  .bhero__inner {
    min-height: 32.5rem; /* 520px */
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding-block: var(--sec-y);
  }

  .bhero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1 1 26rem;
    max-width: 40rem;
    min-width: 0;
  }

  .bhero__title {
    --cap-spill: 0.3em;
    font-size: clamp(3rem, 7.7778vw, 7rem); /* 112px @1440 */
    line-height: var(--lh-hero);
    color: var(--cream);
  }

  .bhero__lede {
    font-size: clamp(1.0625rem, 1.3194vw, 1.1875rem);
    line-height: var(--lh-body);
    color: var(--on-navy);
    max-width: 36rem;
  }

  .bhero__cta {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  /* The frame carries the photo's own ratio so object-fit has nothing left to
     crop: the shot shows in full and still meets all four edges. Stated as the
     source's exact pixel dimensions (2560x1707, a hair off 3:2) rather than a
     rounded 3/2, so there is no sub-pixel trim. Note this differs from the
     distillery hero, whose photo is 16:9 — the ratio tracks each image. */
  .bhero__media {
    flex: 1 1 40rem;
    max-width: 42rem; /* 672px */
    min-width: 0;
    aspect-ratio: 2560 / 1707;
    overflow: hidden;
  }

  .bhero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 68.75rem) {
    .bhero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
    }

    .bhero__copy,
    .bhero__media {
      flex: 0 0 auto;
      max-width: none;
      width: 100%;
    }

    .bhero__media {
      order: -1;
    }
  }
</style>
