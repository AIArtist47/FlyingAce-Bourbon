---
/**
 * Brand marks for the social links.
 *
 * Official paths from Simple Icons (CC0), inlined rather than pulled from
 * their CDN so the footer makes no third-party request and the marks cannot
 * change under us. All three sit in the same 24x24 box.
 *
 * `optical` corrects for how much of that box each glyph actually fills.
 * Measured: Instagram 24x24, Facebook 24x23.9, Google Maps 16.6x24 - the pin
 * is a narrow shape, so at an identical box it reads lighter than the two
 * that fill theirs. It gets a small uniform scale-up to compensate. The
 * scale is applied to the rendered size, not by cropping the viewBox, which
 * would clip a mark that already spans the full height.
 */
type Name = 'instagram' | 'facebook' | 'googlemaps';

interface Props {
  name: Name;
  size?: number;
}

const { name, size = 20 } = Astro.props;

const marks: Record<Name, { title: string; d: string; optical: number }> = {
  instagram: {
    title: 'Instagram',
    optical: 1,
