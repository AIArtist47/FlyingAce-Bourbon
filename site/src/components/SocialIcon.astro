  },
};

const mark = marks[name];
const px = Math.round(size * mark.optical);
---

<svg
  class="smark"
  width={px}
  height={px}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={mark.d} />
</svg>

<style>
  .smark {
    display: block;
    flex: none;
  }
</style>
