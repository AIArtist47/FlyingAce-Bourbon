---
import Icon from './Icon.astro';
import PhotoCarousel from './PhotoCarousel.astro';
import { eventsHero as h, eventFacts } from '../data/events';
---

<section class="ehero on-navy" id="top">
  <div class="ehero__inner wrap">
    <div class="ehero__copy">
      <p class="eyebrow eyebrow--brass" data-reveal="up">{h.eyebrow}</p>
      <h1 class="display ehero__title" data-reveal="up">{h.title}</h1>
      <p class="ehero__lede" data-reveal="up">{h.lede}</p>
      <div class="ehero__cta" data-reveal="up">
        <a class="btn btn--solid btn--lg" href="#enquire">Send an Inquiry</a>
        <a class="btn btn--ghost-light btn--lg" href="#venues">Tour the Spaces</a>
      </div>
    </div>

    <div class="ehero__media" data-reveal="up">
      <PhotoCarousel />
    </div>
  </div>

  <div class="efacts wrap">
    {
      eventFacts.map((f, i) => (
        <div class="efact" data-reveal="up" data-stagger={i}>
          <Icon name={f.icon} size={28} stroke="var(--brass)" width={1.5} />
          <h2 class="display display--700 efact__title">{f.title}</h2>
          <p class="efact__body">{f.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ehero {
    background: var(--navy);
    color: var(--cream);
    padding-bottom: 3.5rem;
  }

  .ehero__inner {
    min-height: 30rem;
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding-block: var(--sec-y);
  }

  .ehero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1 1 28rem;
    max-width: 40rem;
    min-width: 0;
  }

  .ehero__title {
    --cap-spill: 0.3em;
    font-size: clamp(3rem, 7.7778vw, 7rem);
    line-height: var(--lh-hero);
    color: var(--cream);
  }

  .ehero__lede {
    font-size: clamp(1.0625rem, 1.3194vw, 1.1875rem);
    line-height: var(--lh-body);
    color: var(--on-navy);
    max-width: 36rem;
  }

  .ehero__cta {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  /* Holds the carousel, which sets its own height. */
  .ehero__media {
    flex: 1 1 36rem;
    max-width: 42rem;
    min-width: 0;
  }

  /* --- The three reasons ------------------------------------------------ */

  .efacts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule-navy);
  }

  .efact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .efact__title {
    margin: 0;
    font-size: var(--t-26);
    line-height: 1;
  }

  .efact__body {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--on-navy-2);
  }

  @media (max-width: 68.75rem) {
    .ehero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
    }

    .ehero__copy,
    .ehero__media {
      flex: 0 0 auto;
      max-width: none;
      width: 100%;
    }

    .efacts {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
