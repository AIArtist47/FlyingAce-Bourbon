---
import Icon from './Icon.astro';
import { howToBuy } from '../data/distillery';
---

<section class="buy section section--pad" aria-labelledby="buy-title">
  <div class="wrap">
    <h2 class="display buy__h2" id="buy-title" data-reveal="up">How to buy</h2>

    <div class="buy__grid">
      {
        howToBuy.map((item, i) => (
          <div class="buycard" data-reveal="up" data-stagger={i}>
            <Icon name={item.icon} size={34} width={1.4} />
            <h3 class="buycard__title display">{item.title}</h3>
            <p class="buycard__body">{item.body}</p>
            <a
              class="arrow-link"
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.cta} <span class="arrow-link__ico">&#8594;</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .buy__h2 {
    font-size: var(--t-h2-sm);
  }

  .buy__grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .buycard {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 2rem;
    transition: transform 0.45s var(--ease);
  }

  .buycard:hover {
    transform: translateY(-0.25rem);
  }

  .buycard__title {
    font-size: var(--t-30);
    line-height: 1;
    margin: 0;
  }

  .buycard__body {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  @media (max-width: 68.75rem) {
    .buy__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
