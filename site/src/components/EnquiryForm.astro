---
import { site } from '../data/site';
import { enquiry as q, enquiryFields } from '../data/events';

interface Props {
  /** Which inbox an answer lands in when the event type does not say.
      The weddings page starts there; everywhere else starts at events. */
  to?: 'events' | 'weddings';
}

const { to = 'events' } = Astro.props;
const inbox = to === 'weddings' ? q.weddings : q.events;
---

<section class="enq section section--pad" id="enquire" aria-labelledby="enq-title">
  <div class="enq__inner wrap">
    <div class="enq__intro">
      <p class="eyebrow" data-reveal="up">{q.kicker}</p>
      <h2 class="display enq__h2" id="enq-title" data-reveal="up">{q.title}</h2>
      <p class="lede enq__lede" data-reveal="up">{q.body}</p>

      <dl class="enq__direct" data-reveal="up">
        <div>
          <dt class="label">Events</dt>
          <dd><a href={`mailto:${q.events}`}>{q.events}</a></dd>
        </div>
        <div>
          <dt class="label">Weddings</dt>
          <dd><a href={`mailto:${q.weddings}`}>{q.weddings}</a></dd>
        </div>
        <div>
          <dt class="label">Prefer to talk</dt>
          <dd><a href={site.phoneHref}>{site.phone}</a></dd>
        </div>
      </dl>
    </div>

    {/* The action and method are real, not decoration. The script posts this
        form itself and never leaves the page, but if it fails to arrive the
        browser posts it natively to the same endpoint and is handed back to
        /inquiry-sent -- so the form works with no JavaScript at all. A form
        with no action would default to GET on the current URL, writing the
        visitor's name, phone and email into the address bar, their history
        and any referrer. */}
    <form
      class="enq__form"
      action="/api/enquiry"
      method="post"
      data-enquiry
      novalidate
      data-reveal="up"
      data-stagger="1"
    >
      <input type="hidden" name="inbox" value={to} />
      <div class="enq__grid">
        {
          enquiryFields.map((f) => (
            <p class={`field${f.type === 'text' && f.id === 'kind' ? ' field--wide' : ''}`}>
              <label class="field__label" for={`q-${f.id}`}>
                {f.label}
                {f.required && <span class="field__req" aria-hidden="true">*</span>}
              </label>
              <input
                class="field__input"
                id={`q-${f.id}`}
                name={f.id}
                type={f.type}
                autocomplete={f.autocomplete || undefined}
                data-required={f.required ? 'true' : undefined}
                data-label={f.label}
              />
            </p>
          ))
        }

        <p class="field field--wide">
          <label class="field__label" for="q-notes">Anything else you’d like to include?</label>
          <textarea class="field__input field__input--area" id="q-notes" name="notes" rows="4"></textarea>
        </p>
      </div>

      {/* Off-screen and out of the tab order, so a person never meets it.
          Anything that fills it in is not one, and the server quietly drops
          that inquiry. */}
      <p class="enq__pot" aria-hidden="true">
        <label for="q-company">Company</label>
        <input id="q-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </p>

      <div class="enq__send">
        <button class="btn btn--solid btn--lg" type="submit" data-send>Send Inquiry</button>
        <p class="enq__status" id="enq-status" role="status" aria-live="polite" data-status></p>
      </div>

      {/* Said plainly rather than discovered after pressing the button. */}
      <p class="enq__note">
        This goes straight to {inbox}. We will reply to the address you leave above.
      </p>
    </form>

    {/* Takes the form's place once the inquiry is away, so the end of the job
        is unmistakable rather than a line of text under a button that still
        looks pressable. Focus moves here, which is also how a screen reader
        is told the page has changed. */}
    <div class="enq__done" id="enq-done" tabindex="-1" hidden data-done>
      <p class="eyebrow">Thank you</p>
      <h3 class="display enq__done-h">Your inquiry is on its way</h3>
      <p class="enq__done-body">
        We read every one and will come back to you at the address you left.
      </p>
      {/* On its own line rather than inside the sentence above: an address is
          one unbreakable 25-character word, and in a paragraph on a phone it
          drags the measure down to half a line. */}
      <p class="enq__done-to">
        <span class="label">Sent to</span>
        <span data-done-inbox>{inbox}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .enq__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: start;
  }

  .enq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .enq__h2 {
    margin: 0;
    font-size: var(--t-h2-sm);
  }

  .enq__lede {
    margin: 0;
    max-width: 32ch;
  }

  .enq__direct {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .enq__direct div {
    display: grid;
    gap: 0.1875rem;
  }

  .enq__direct dt {
    margin: 0;
  }

  .enq__direct dd {
    margin: 0;
  }

  .enq__direct a {
    font-size: var(--t-15);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s var(--ease);
  }

  .enq__direct a:hover {
    border-bottom-color: var(--accent);
  }

  /* --- The form --------------------------------------------------------- */

  .enq__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    min-width: 0;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  /* Label above the input, never a placeholder standing in for one. */
  .field__label {
    font-size: var(--t-13);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .field__req {
    margin-left: 0.125rem;
    color: var(--accent);
  }

  .field__input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-15);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .field__input:hover {
    border-color: var(--muted-2);
  }

  .field__input--area {
    min-height: 7rem;
    resize: vertical;
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .enq__send {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* Never shown and never reached: off-screen rather than display:none,
     because the point is that something filling in every field finds it. */
  .enq__pot {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .enq__status {
    margin: 0;
    font-size: var(--t-15);
    color: var(--accent);
  }

  /* In flight, where nothing is wrong yet. */
  .enq__status[data-tone='busy'] {
    color: var(--muted-2);
  }

  .enq__status a {
    color: inherit;
  }

  /* --- Sent -------------------------------------------------------------- */

  .enq__done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 2.5rem;
    background: var(--sand);
    border: 1px solid var(--rule);
  }

  .enq__done[hidden] {
    display: none;
  }

  .enq__done-h {
    margin: 0;
    font-size: var(--t-32);
  }

  .enq__done-body {
    margin: 0;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--muted);
    max-width: 44ch;
  }

  .enq__done-to {
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.1875rem;
    font-size: var(--t-15);
    color: var(--accent);
  }

  .enq__note {
    margin: 0.875rem 0 0;
    font-size: var(--t-13);
    color: var(--muted-2);
  }

  @media (max-width: 68.75rem) {
    .enq__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .enq__h2 {
      font-size: var(--t-44);
    }
  }

  @media (max-width: 34rem) {
    .enq__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* 40px of padding either side of a 335px panel leaves a 28-character
       measure, which is half of what a sentence wants. */
    .enq__done {
      padding: 1.75rem;
    }
  }
</style>

<script>
  import { enquiry } from '../data/events';

  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const status = form?.querySelector<HTMLParagraphElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('[data-send]');
  const done = document.querySelector<HTMLElement>('[data-done]');

  if (form && status && button && done) {
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[name]')].filter(
      (f) => f.type !== 'hidden' && f.name !== 'company',
    );

    const say = (text: string, tone?: 'busy') => {
      status.textContent = text;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    const clear = (el: Element) => {
      el.removeAttribute('aria-invalid');
      say('');
    };
    fields.forEach((f) => f.addEventListener('input', () => clear(f)));

    const fail = (el: HTMLInputElement | HTMLTextAreaElement, msg: string) => {
      el.setAttribute('aria-invalid', 'true');
      say(msg);
      el.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      fields.forEach((f) => f.removeAttribute('aria-invalid'));

      /* Validate in the order the fields are read, so focus lands on the
         first thing wrong rather than the last. The server checks all of this
         again -- this pass is for the visitor, not for trust. */
      for (const f of fields) {
        if (f.dataset.required === 'true' && !f.value.trim()) {
          fail(f, `${f.dataset.label ?? 'This field'} is needed.`);
          return;
        }
      }

      const email = form.querySelector<HTMLInputElement>('#q-email')!;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
        fail(email, 'Please enter a valid email address.');
        return;
      }

      button.disabled = true;
      say('Sending…', 'busy');

      /* The endpoint does the sending, so nothing here opens a mail app and
         nothing leaves the page. Posting as JSON is what tells it to answer
         in kind rather than redirect -- the browser's own POST, which is what
         happens if this script never loaded, gets the redirect instead. */
      const answers = Object.fromEntries(new FormData(form));

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(answers),
        });
        const result = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          to?: string;
          error?: string;
        };

        if (!response.ok || !result.ok) throw new Error(result.error ?? 'The inquiry could not be sent.');

        const inbox = document.querySelector<HTMLElement>('[data-done-inbox]');
        if (inbox && result.to) inbox.textContent = result.to;

        form.hidden = true;
        done.hidden = false;
        done.focus();
      } catch (error) {
        button.disabled = false;
        /* Named, and with a way through that does not depend on this working:
           an inquiry that quietly fails is worse than one that was never
           started. */
        const to = /wedding|ceremony|bridal|rehearsal|elope/i.test(
          form.querySelector<HTMLInputElement>('#q-kind')?.value ?? '',
        )
          ? enquiry.weddings
          : enquiry.events;

        say(error instanceof Error ? error.message : 'The inquiry could not be sent.');
        status.insertAdjacentHTML('beforeend', ` Please email <a href="mailto:${to}">${to}</a>.`);
      }
    });
  }
</script>
