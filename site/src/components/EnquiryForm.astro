---
import { site } from '../data/site';
import { enquiry as q, enquiryFields } from '../data/events';

interface Props {
  /** Which inbox the form opens against before the script reads the answers.
      The weddings page starts there; everywhere else starts at events. */
  to?: 'events' | 'weddings';
}

const { to = 'events' } = Astro.props;
const inbox = to === 'weddings' ? q.weddings : q.events;
---

<section class="enq section section--pad" id="enquire" aria-labelledby="enq-title">
  <div class="enq__inner wrap">
    <div class="enq__intro">
      <p class="eyebrow" data-reveal="up">{q.kicker}</p>
      <h2 class="display enq__h2" id="enq-title" data-reveal="up">{q.title}</h2>
      <p class="lede enq__lede" data-reveal="up">{q.body}</p>

      <dl class="enq__direct" data-reveal="up">
        <div>
          <dt class="label">Events</dt>
          <dd><a href={`mailto:${q.events}`}>{q.events}</a></dd>
        </div>
        <div>
          <dt class="label">Weddings</dt>
          <dd><a href={`mailto:${q.weddings}`}>{q.weddings}</a></dd>
        </div>
        <div>
          <dt class="label">Prefer to talk</dt>
          <dd><a href={site.phoneHref}>{site.phone}</a></dd>
        </div>
      </dl>
    </div>

    {/* The action matters even though script normally intercepts it. A form
        with no action defaults to GET on the current URL, so if the script
        ever fails to load, submitting would write the visitor's name, phone
        and email into the address bar, their history and any referrer. Posting
        to mailto keeps those in the request body and, without script, still
        opens their mail app. */}
    <form
      class="enq__form"
      action={`mailto:${inbox}`}
      method="post"
      enctype="text/plain"
      data-enquiry
      novalidate
      data-reveal="up"
      data-stagger="1"
    >
      <div class="enq__grid">
        {
          enquiryFields.map((f) => (
            <p class={`field${f.type === 'text' && f.id === 'kind' ? ' field--wide' : ''}`}>
              <label class="field__label" for={`q-${f.id}`}>
                {f.label}
                {f.required && <span class="field__req" aria-hidden="true">*</span>}
              </label>
              <input
                class="field__input"
                id={`q-${f.id}`}
                name={f.id}
                type={f.type}
                autocomplete={f.autocomplete || undefined}
                data-required={f.required ? 'true' : undefined}
                data-label={f.label}
              />
            </p>
          ))
        }

        <p class="field field--wide">
          <label class="field__label" for="q-notes">Anything else you’d like to include?</label>
          <textarea class="field__input field__input--area" id="q-notes" name="notes" rows="4"></textarea>
        </p>
      </div>

      <div class="enq__send">
        <button class="btn btn--solid btn--lg" type="submit">Send Inquiry</button>
        <p class="enq__status" id="enq-status" role="status" aria-live="polite" data-status></p>
      </div>

      {/* Said plainly rather than discovered after pressing the button. */}
      <p class="enq__note">
        This opens the message in your own mail app so you can check it before it goes.
      </p>
    </form>
  </div>
</section>

<style>
  .enq__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: start;
  }

  .enq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .enq__h2 {
    margin: 0;
    font-size: var(--t-h2-sm);
  }

  .enq__lede {
    margin: 0;
    max-width: 32ch;
  }

  .enq__direct {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .enq__direct div {
    display: grid;
    gap: 0.1875rem;
  }

  .enq__direct dt {
    margin: 0;
  }

  .enq__direct dd {
    margin: 0;
  }

  .enq__direct a {
    font-size: var(--t-15);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s var(--ease);
  }

  .enq__direct a:hover {
    border-bottom-color: var(--accent);
  }

  /* --- The form --------------------------------------------------------- */

  .enq__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    min-width: 0;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  /* Label above the input, never a placeholder standing in for one. */
  .field__label {
    font-size: var(--t-13);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .field__req {
    margin-left: 0.125rem;
    color: var(--accent);
  }

  .field__input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-15);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .field__input:hover {
    border-color: var(--muted-2);
  }

  .field__input--area {
    min-height: 7rem;
    resize: vertical;
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .enq__send {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .enq__status {
    margin: 0;
    font-size: var(--t-15);
    color: var(--accent);
  }

  .enq__note {
    margin: 0.875rem 0 0;
    font-size: var(--t-13);
    color: var(--muted-2);
  }

  @media (max-width: 68.75rem) {
    .enq__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .enq__h2 {
      font-size: var(--t-44);
    }
  }

  @media (max-width: 34rem) {
    .enq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { enquiry } from '../data/events';

  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const status = form?.querySelector<HTMLParagraphElement>('[data-status]');

  if (form && status) {
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[name]')];

    const clear = (el: Element) => {
      el.removeAttribute('aria-invalid');
      status.textContent = '';
    };
    fields.forEach((f) => f.addEventListener('input', () => clear(f)));

    const fail = (el: HTMLInputElement | HTMLTextAreaElement, msg: string) => {
      el.setAttribute('aria-invalid', 'true');
      status.textContent = msg;
      el.focus();
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      fields.forEach((f) => f.removeAttribute('aria-invalid'));

      /* Validate in the order the fields are read, so focus lands on the
         first thing wrong rather than the last. */
      for (const f of fields) {
        if (f.dataset.required === 'true' && !f.value.trim()) {
          fail(f, `${f.dataset.label ?? 'This field'} is needed.`);
          return;
        }
      }

      const email = form.querySelector<HTMLInputElement>('#q-email')!;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
        fail(email, 'Please enter a valid email address.');
        return;
      }

      /* A wedding enquiry goes to the weddings address, as the farm asks. */
      const kind = (form.querySelector<HTMLInputElement>('#q-kind')?.value ?? '').toLowerCase();
      const to = /wedding|ceremony|bridal|rehearsal/.test(kind) ? enquiry.weddings : enquiry.events;

      const first = form.querySelector<HTMLInputElement>('#q-first')!.value.trim();
      const last = form.querySelector<HTMLInputElement>('#q-last')!.value.trim();

      const lines = fields
        .filter((f) => f.value.trim())
        .map((f) => `${f.dataset.label ?? f.name}: ${f.value.trim()}`);

      /* No backend on a static site, and the farm's own form is a WordPress
         endpoint this origin cannot post to. Handing the composed message to
         the visitor's mail app actually delivers it, and they see what is
         being sent before it goes. */
      const href =
        `mailto:${to}` +
        `?subject=${encodeURIComponent(`Event inquiry — ${first} ${last}`.trim())}` +
        `&body=${encodeURIComponent(lines.join('\n'))}`;

      status.textContent = `Opening your mail app, addressed to ${to}.`;
      window.location.href = href;
    });
  }
</script>
