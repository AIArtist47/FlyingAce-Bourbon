---
import { site } from '../data/site';
import { forms, type FormKind } from '../data/forms';

interface Props {
  /** Which form to render. Every one goes to the same inbox; this rides along
      with the message so the farm can tell a job application from a wedding. */
  kind?: FormKind;
}

const { kind = 'events' } = Astro.props;
const spec = forms[kind];

/* A form carrying a file has to say so in its encoding, or the browser's own
   POST -- the one that happens when the script below never loaded -- sends
   the file's name and none of its bytes. */
const hasFile = spec.fields.some((f) => f.type === 'file');
---

<section class="enq section section--pad" id="enquire" aria-labelledby="enq-title">
  <div class="enq__inner wrap">
    <div class="enq__intro">
      <p class="eyebrow" data-reveal="up">{spec.kicker}</p>
      <h2 class="display enq__h2" id="enq-title" data-reveal="up">{spec.title}</h2>
      <p class="lede enq__lede" data-reveal="up">{spec.body}</p>

      <dl class="enq__direct" data-reveal="up">
        <div>
          <dt class="label">Email us</dt>
          <dd><a class="tap-box" href={`mailto:${spec.inbox}`}>{spec.inbox}</a></dd>
        </div>
        <div>
          <dt class="label">Prefer to talk</dt>
          <dd><a class="tap-box" href={site.phoneHref}>{site.phone}</a></dd>
        </div>
      </dl>
    </div>

    {/* The action and method are real, not decoration. The script posts this
        form itself and never leaves the page, but if it fails to arrive the
        browser posts it natively to the same endpoint and is handed back to
        /inquiry-sent -- so the form works with no JavaScript at all. A form
        with no action would default to GET on the current URL, writing the
        visitor's name, phone and email into the address bar, their history
        and any referrer. */}
    <form
      class="enq__form"
      action="/api/enquiry"
      method="post"
      enctype={hasFile ? 'multipart/form-data' : undefined}
      data-enquiry
      data-inbox={spec.inbox}
      novalidate
      data-reveal="up"
      data-stagger="1"
    >
      <input type="hidden" name="page" value={kind} />
      <div class="enq__grid">
        {
          spec.fields.map((f) => (
            <p class={`field${f.wide ? ' field--wide' : ''}`}>
              <label class="field__label" for={`q-${f.id}`}>
                {f.label}
                {f.required && <span class="field__req" aria-hidden="true">*</span>}
              </label>
              {f.type === 'select' ? (
                <select
                  class="field__input field__input--select"
                  id={`q-${f.id}`}
                  name={f.id}
                  data-required={f.required ? 'true' : undefined}
                  data-label={f.label}
                >
                  <option value="">Choose one</option>
                  {(f.options ?? []).map((o) => (
                    <option value={o}>{o}</option>
                  ))}
                </select>
              ) : (
                <input
                  class={`field__input${f.type === 'file' ? ' field__input--file' : ''}`}
                  id={`q-${f.id}`}
                  name={f.id}
                  type={f.type}
                  accept={f.accept || undefined}
                  autocomplete={f.autocomplete || undefined}
                  aria-describedby={f.hint ? `q-${f.id}-hint` : undefined}
                  data-required={f.required ? 'true' : undefined}
                  data-label={f.label}
                  data-max={f.maxBytes ? String(f.maxBytes) : undefined}
                />
              )}
              {/* Tied to the input by aria-describedby, so the limit is read
                  out with the field rather than found after the fact. */}
              {f.hint && (
                <span class="field__hint" id={`q-${f.id}-hint`}>
                  {f.hint}
                </span>
              )}
            </p>
          ))
        }

        <p class="field field--wide">
          <label class="field__label" for="q-notes">
            {spec.notes.label}
            {spec.notes.required && <span class="field__req" aria-hidden="true">*</span>}
          </label>
          <textarea
            class="field__input field__input--area"
            id="q-notes"
            name="notes"
            rows={spec.notes.rows}
            data-required={spec.notes.required ? 'true' : undefined}
            data-label={spec.notes.label}
          />
        </p>
      </div>

      {/* Off-screen and out of the tab order, so a person never meets it.
          Anything that fills it in is not one, and the server quietly drops
          that inquiry. */}
      <p class="enq__pot" aria-hidden="true">
        <label for="q-company">Company</label>
        <input id="q-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </p>

      <div class="enq__send">
        <button
          class="btn btn--solid btn--lg"
          type="submit"
          data-send
          data-label={spec.submit}
          data-noun={spec.sentNoun}
        >
          {spec.submit}
        </button>
        <p class="enq__status" id="enq-status" role="status" aria-live="polite" data-status></p>
      </div>

      {/* Said plainly rather than discovered after pressing the button, and
          gone once it has been: the status line above says where the message
          went, and the same address twice in three lines is noise. */}
      <p class="enq__note" data-note>
        This goes straight to {spec.inbox}. We will reply to the address you leave above.
        {spec.foot && <><br />{spec.foot}</>}
      </p>
    </form>

  </div>
</section>

<style>
  .enq__inner {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 4rem;
    align-items: start;
  }

  .enq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .enq__h2 {
    margin: 0;
    font-size: var(--t-h2-sm);
  }

  .enq__lede {
    margin: 0;
    max-width: 32ch;
  }

  .enq__direct {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .enq__direct div {
    display: grid;
    gap: 0.1875rem;
  }

  .enq__direct dt {
    margin: 0;
  }

  .enq__direct dd {
    margin: 0;
  }

  .enq__direct a {
    font-size: var(--t-15);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s var(--ease);
  }

  .enq__direct a:hover {
    border-bottom-color: var(--accent);
  }

  /* --- The form --------------------------------------------------------- */

  .enq__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    min-width: 0;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  /* Label above the input, never a placeholder standing in for one. */
  .field__label {
    font-size: var(--t-13);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .field__req {
    margin-left: 0.125rem;
    color: var(--accent);
  }

  .field__input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-15);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .field__input:hover {
    border-color: var(--muted-2);
  }

  .field__input--select {
    appearance: none;
    cursor: pointer;
    /* Room for the chevron, which is painted on the wrapper below. */
    padding-right: 2.5rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position:
      calc(100% - 1.125rem) calc(50% + 0.1rem),
      calc(100% - 0.75rem) calc(50% + 0.1rem);
    background-size: 0.375rem 0.375rem;
    background-repeat: no-repeat;
  }

  .field__input--area {
    min-height: 7rem;
    resize: vertical;
  }

  /* The native control, kept. It is the one field here a browser already
     does better than we would: a custom one loses the keyboard, the file
     name it reports back, and the name a screen reader reads for it. Only
     the button inside it is restyled, which is all ::file-selector-button
     allows and all that is wanted. */
  .field__input--file {
    padding: 0.4375rem 0.75rem;
    cursor: pointer;
  }

  .field__input--file::file-selector-button {
    margin-right: 0.75rem;
    padding: 0.3125rem 0.875rem;
    border: 1px solid var(--rule);
    background: var(--sand);
    color: var(--ink);
    font: inherit;
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: var(--ls-caps-sm);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .field__input--file:hover::file-selector-button {
    background: var(--paper);
    border-color: var(--muted-2);
  }

  .field__hint {
    font-size: var(--t-12);
    line-height: var(--lh-body);
    color: var(--muted-2);
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .enq__send {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* Never shown and never reached: off-screen rather than display:none,
     because the point is that something filling in every field finds it. */
  .enq__pot {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .enq__status {
    margin: 0;
    font-size: var(--t-15);
    color: var(--accent);
  }

  /* In flight, where nothing is wrong yet. */
  .enq__status[data-tone='busy'] {
    color: var(--muted-2);
  }

  .enq__status a {
    color: inherit;
  }

  /* Sent. Not the red of something still waiting to be pressed, and not the
     half-opacity of something merely switched off -- the job is finished, and
     the button says so at full strength. */
  .enq__send [data-state='sent'] {
    background: var(--navy);
    color: var(--cream);
    opacity: 1;
  }

  .enq__status[data-tone='sent'] {
    color: var(--ink-soft);
  }

  .enq__note[hidden] {
    display: none;
  }

  .enq__note {
    margin: 0.875rem 0 0;
    font-size: var(--t-13);
    color: var(--muted-2);
  }

  @media (max-width: 68.75rem) {
    .enq__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .enq__h2 {
      font-size: var(--t-44);
    }
  }

  @media (max-width: 34rem) {
    .enq__grid {
      grid-template-columns: minmax(0, 1fr);
    }

  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const status = form?.querySelector<HTMLParagraphElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('[data-send]');
  const note = form?.querySelector<HTMLParagraphElement>('[data-note]');

  if (form && status && button) {
    type Field = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const fields = [...form.querySelectorAll<Field>('[name]')].filter(
      (f) => f.type !== 'hidden' && f.name !== 'company',
    );

    /* Once it is away it stays away. The button is the record of that, so
       nothing below is allowed to quietly put it back. */
    let sent = false;

    const say = (text: string, tone?: 'busy' | 'sent') => {
      status.textContent = text;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    };

    const label = (text: string, state?: 'sent') => {
      button.textContent = text;
      if (state) button.dataset.state = state;
      else delete button.dataset.state;
    };

    fields.forEach((f) =>
      f.addEventListener('input', () => {
        if (sent) return;
        f.removeAttribute('aria-invalid');
        say('');
      }),
    );

    const fail = (el: Field, msg: string) => {
      el.setAttribute('aria-invalid', 'true');
      say(msg);
      el.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sent) return;
      fields.forEach((f) => f.removeAttribute('aria-invalid'));

      /* Validate in the order the fields are read, so focus lands on the
         first thing wrong rather than the last. The server checks all of this
         again -- this pass is for the visitor, not for trust. */
      for (const f of fields) {
        if (f.dataset.required === 'true' && !f.value.trim()) {
          fail(f, `${f.dataset.label ?? 'This field'} is needed.`);
          return;
        }
      }

      const email = form.querySelector<HTMLInputElement>('#q-email')!;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
        fail(email, 'Please enter a valid email address.');
        return;
      }

      /* Before the upload rather than after it: a phone on a slow connection
         should not spend four megabytes to be told no. The server measures
         it again, because this one is a courtesy. */
      for (const f of fields) {
        if (!(f instanceof HTMLInputElement) || f.type !== 'file') continue;
        const max = Number(f.dataset.max ?? 0);
        const picked = f.files?.[0];
        if (max && picked && picked.size > max) {
          const mb = Math.round((max / (1024 * 1024)) * 10) / 10;
          fail(f, `${f.dataset.label ?? 'That file'} must be under ${mb} MB.`);
          return;
        }
      }

      button.disabled = true;
      label('Sending…');
      say('', 'busy');

      /* The endpoint does the sending, so nothing here opens a mail app and
         nothing leaves the page.

         Sent as the form's own data rather than as JSON, which cannot carry
         the resume on the careers form -- one transport for all five, since
         the endpoint has always read this shape for the no-script path. The
         Accept header is what now asks for an answer in kind: the browser's
         own POST, which is what happens if this script never loaded, does
         not send it and is redirected instead.

         No content-type is set on purpose. FormData has to name its own
         boundary, and setting the header by hand drops it. */
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { accept: 'application/json' },
          body: new FormData(form),
        });
        const result = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          to?: string;
          error?: string;
        };

        if (!response.ok || !result.ok)
          throw new Error(result.error ?? `That ${button.dataset.noun ?? 'inquiry'} could not be sent.`);

        sent = true;
        if (note) note.hidden = true;
        /* The button itself is the confirmation: it stops being a thing to
           press and becomes a statement that the job is done. The line under
           it says where the message went. */
        label('Sent', 'sent');
        const noun = button.dataset.noun ?? 'inquiry';
        say(`Your ${noun} is with ${result.to ?? 'the team'}. We will come back to you at ${email.value.trim()}.`, 'sent');
      } catch (error) {
        button.disabled = false;
        label(button.dataset.label ?? 'Send Inquiry');
        /* Named, and with a way through that does not depend on this working:
           an inquiry that quietly fails is worse than one that was never
           started. */
        const to = form.dataset.inbox ?? '';

        say(error instanceof Error ? error.message : 'The inquiry could not be sent.');
        status.insertAdjacentHTML('beforeend', ` Please email <a href="mailto:${to}">${to}</a>.`);
      }
    });
  }
</script>
