---
import Lightbox from './Lightbox.astro';
import { galleryRows, galleryCount } from '../data/wedding-gallery';

const W = '/images/weddings';

/**
 * Four rows drifting in opposite directions — 1 and 3 right to left, 2 and 4
 * left to right — carrying every photograph the farm publishes.
 *
 * The motion is a CSS animation rather than a transform written per frame: the
 * sequence is fixed and repeating, which is the one case keyframes suit, and
 * it costs no main-thread work at all.
 *
 * Each row's list is laid down twice and travels exactly half the track, so
 * the frame at 100% is the frame at 0% and the loop has no seam. The gap lives
 * on the frames rather than the track: with `gap` on a track holding two
 * copies, half a gap falls inside that travel and the loop slips by it every
 * cycle.
 */

/* One speed for every row. The rows hold different numbers of frames at
   different widths, so a shared duration would have them drifting at visibly
   different rates — each row's duration is worked out from how far it actually
   has to travel. Three of them, because the rows shrink twice and a duration
   is only right for the height it was measured at. */
const SPEED = 46; // px per second
const GAP = { lg: 10, md: 8, sm: 6 };
const ROW_H = { lg: 180, md: 140, sm: 104 };

const dur = (row: { w: number; h: number }[], h: number, gap: number) =>
  Math.round(row.reduce((a, f) => a + (f.w * h) / f.h + gap, 0) / SPEED);

/* Numbered into one flat run, so the lightbox steps across the whole gallery
   rather than restarting at each row. */
let n = -1;
const rows = galleryRows.map((row, r) => ({
  dir: r % 2 === 0 ? 'rtl' : 'ltr',
  style: [
    `--dur-lg:${dur(row, ROW_H.lg, GAP.lg)}s`,
    `--dur-md:${dur(row, ROW_H.md, GAP.md)}s`,
    `--dur-sm:${dur(row, ROW_H.sm, GAP.sm)}s`,
  ].join(';'),
  frames: row.map((f) => ({ ...f, n: ++n })),
}));
---

<section class="wgal section section--pad" id="gallery" aria-labelledby="wgal-title">
  <div class="wrap">
    {/* The lettermark is the heading, so it stays an h2 and carries what it
        actually says as its alt — both lines, not just the brass one — so the
        section's accessible name is the whole phrase, as it reads. */}
    <h2 class="wgal__mark" id="wgal-title" data-reveal="up">
      <img
        class="wgal__markimg"
        src={`${W}/lettermark.webp`}
        alt="And yeah! This is how we do Weddings"
        width="664"
        height="260"
      />
    </h2>
  </div>

  {/* Outside the wrap, so the rows run the full width of the window and the
      frames at either end are cut by the edge rather than by a margin. */}
  <div class="wrows" data-wrows>
    {
      rows.map((row) => (
        <div class={`wrow wrow--${row.dir}`} style={row.style}>
          <div class="wrow__track">
            {[0, 1].map((copy) =>
              row.frames.map((f) => (
                <button
                  class="wframe"
                  type="button"
                  style={`--ar:${f.w} / ${f.h}`}
                  data-lb-open={f.n}
                  data-lb-src={`${W}/full/${f.id}.webp`}
                  data-lb-alt={`A wedding at Flying Ace Farm, photograph ${f.n + 1} of ${galleryCount}`}
                  aria-label={`Open wedding photograph ${f.n + 1} of ${galleryCount}`}
                  {...(copy === 1 ? { tabindex: -1, 'aria-hidden': 'true' } : {})}
                >
                  <img
                    class="wframe__img"
                    src={`${W}/thumb/${f.id}.webp`}
                    alt=""
                    width={f.w}
                    height={f.h}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>

  <Lightbox label="Weddings at Flying Ace Farm" />
</section>

<style>
  /* Dark on purpose: seventy-seven photographs at once need somewhere to sit,
     and the cream page lets them fight each other. .on-navy only sets the
     selection and focus colours — the background has to be stated. */
  .wgal {
    background: var(--navy);
    overflow: hidden;
  }

  /* Sized by height, since a script mark is read at its x-height rather than
     by a type step. Two lines of ink: the lower one is rgb(217, 185, 122),
     which is --brass exactly, and the upper is pure white — both already the
     section's own colours, and the file carries its own alpha, so it sits on
     the navy with nothing behind it. */
  .wgal__mark {
    margin: 0;
    line-height: 0;
  }

  .wgal__markimg {
    display: block;
    height: clamp(4rem, 10vw, 9rem);
    width: auto;
    /* Centred across the page. The rows run full bleed and the wrap is itself
       centred, so centring in the wrap puts the mark over the middle of them.
       Height is untouched. */
    margin-inline: auto;
  }

  /* --- The rows --------------------------------------------------------- */

  .wrows {
    --row-h: 11.25rem; /* 180px */
    --row-gap: 0.625rem;
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }

  .wrow {
    overflow: hidden;
    height: var(--row-h);
  }

  .wrow__track {
    display: flex;
    width: max-content;
    height: 100%;
    animation-duration: var(--dur-lg);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* Rows 1 and 3 run right to left, 2 and 4 the other way. Both travel the
     same half of the track; only the direction differs. */
  .wrow--rtl .wrow__track {
    animation-name: wrow-left;
  }

  .wrow--ltr .wrow__track {
    animation-name: wrow-right;
  }

  @keyframes wrow-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes wrow-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* The gap sits on the frames, not the track. */
  .wframe {
    flex: none;
    height: 100%;
    aspect-ratio: var(--ar);
    margin-right: var(--row-gap);
    padding: 0;
    border: 0;
    background: var(--rule-navy);
    overflow: hidden;
    cursor: pointer;
    position: relative;
  }

  .wframe__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s var(--ease),
      opacity 0.4s var(--ease);
  }

  .wframe:hover .wframe__img {
    transform: scale(1.06);
  }

  /* The rows read as one field, so pointing at a frame settles the rest back
     rather than lifting the one. */
  .wrows:hover .wframe__img {
    opacity: 0.5;
  }

  .wrows:hover .wframe:hover .wframe__img {
    opacity: 1;
  }

  /* Holds still while someone is looking at a frame, and while the band is off
     screen — a loop burns the compositor with nothing on screen to show for
     it. Paused rather than stopped, so it picks up where it left off. */
  .wrows:hover .wrow__track,
  .wrows[data-visible='false'] .wrow__track {
    animation-play-state: paused;
  }

  @media (max-width: 68.75rem) {
    .wrows {
      --row-h: 8.75rem; /* 140px */
      --row-gap: 0.5rem;
    }

    .wrow__track {
      animation-duration: var(--dur-md);
    }
  }

  @media (max-width: 36rem) {
    .wrows {
      --row-h: 6.5rem; /* 104px */
      --row-gap: 0.375rem;
    }

    .wrow__track {
      animation-duration: var(--dur-sm);
    }
  }

  /* No drift for anyone who asked for less motion. Each row becomes one they
     scroll themselves, and the second pass goes, so it is the gallery once
     rather than twice. */
  @media (prefers-reduced-motion: reduce) {
    .wrow {
      overflow-x: auto;
    }

    .wrow__track {
      animation: none;
    }

    .wframe[aria-hidden='true'] {
      display: none;
    }

    .wframe:hover .wframe__img {
      transform: none;
    }
  }
</style>

<script>
  /* A loop burns the compositor even with nothing on screen to show for it. */
  const rows = document.querySelector<HTMLElement>('[data-wrows]');

  if (rows && 'IntersectionObserver' in window) {
    rows.dataset.visible = 'true';
    new IntersectionObserver(
      ([entry]) => {
        rows.dataset.visible = entry.isIntersecting ? 'true' : 'false';
      },
      { rootMargin: '150px' },
    ).observe(rows);
  }
</script>
