---
import Lightbox from './Lightbox.astro';
import { weddingGallery } from '../data/weddings';
---

<section class="wgal section section--pad on-navy" id="gallery" aria-labelledby="wgal-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow eyebrow--brass" data-reveal="up">Weddings at Flying Ace Farm</p>
        <h2 class="display wgal__h2" id="wgal-title" data-reveal="up">Three weddings</h2>
      </div>
      <p class="wgal__hint" data-reveal="up">Open any frame</p>
    </div>

    <ul class="wgal__grid">
      {
        weddingGallery.map((s, i) => (
          <li class={`wshot wshot--${s.shape}`} data-reveal="up" data-stagger={i % 4}>
            <button
              class="wshot__btn"
              type="button"
              data-lb-open={i}
              data-lb-src={s.full}
              data-lb-alt={s.alt}
            >
              <img
                class="wshot__img"
                src={s.thumb}
                alt={s.alt}
                loading="lazy"
                decoding="async"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <Lightbox label="Weddings at Flying Ace Farm" />
</section>

<style>
  /* The band is dark on purpose: twelve photographs at once need somewhere to
     sit, and the cream page lets them fight each other. .on-navy only sets the
     selection and focus colours -- the background has to be stated. */
  .wgal {
    background: var(--navy);
  }

  .wgal__h2 {
    font-size: var(--t-h2);
    color: var(--cream);
  }

  .wgal__hint {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--on-navy-3);
  }

  /*
   * A mosaic rather than one crop ratio for everything. The set is half
   * portrait and half landscape, and forcing either into the other's shape
   * cuts heads off or throws away half a wedding party -- so each frame keeps
   * its own orientation and takes the cell that suits it.
   *
   * grid-auto-flow: dense is what makes that safe: the spans do not tile on
   * their own, and without it the browser leaves holes wherever a tall frame
   * will not fit the current row.
   */
  .wgal__grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 12rem;
    grid-auto-flow: dense;
    gap: 0.75rem;
  }

  .wshot--tall {
    grid-row: span 2;
  }

  /* Two cells each way. A 2x1 at this column width is 3.7:1, which is most of
     a 3:2 photograph thrown away; 2x2 lands near 1.6:1. */
  .wshot--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .wshot {
    min-width: 0;
  }

  /* The whole frame is the control, so it takes focus and Enter as well as a
     click. The UA's button chrome comes off. */
  .wshot__btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--rule-navy);
    cursor: pointer;
    overflow: hidden;
    position: relative;
  }

  .wshot__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s var(--ease),
      opacity 0.5s var(--ease);
  }

  .wshot__btn:hover .wshot__img {
    transform: scale(1.05);
  }

  /* The set reads as one field, so hovering one frame settles the rest back
     rather than lifting the one. Same idea the old brewery grid used. */
  .wgal__grid:hover .wshot__img {
    opacity: 0.55;
  }

  .wgal__grid:hover .wshot__btn:hover .wshot__img {
    opacity: 1;
  }

  @media (max-width: 60rem) {
    /* Two columns still tiles: the same order walks it as 14 full rows. */
    .wgal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 10rem;
    }
  }

  @media (max-width: 36rem) {
    .wgal__grid {
      grid-auto-rows: 7.5rem;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wshot__btn:hover .wshot__img {
      transform: none;
    }
  }
</style>
