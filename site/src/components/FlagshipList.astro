---
import { flagships } from '../data/brewery';
---

<section class="flags section section--pad" id="draft" aria-labelledby="flags-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">Draft list</p>
        <h2 class="display flags__h2" id="flags-title" data-reveal="up">Flagships</h2>
      </div>
      <a class="arrow-link" href="#seasonal" data-reveal="up">
        Seasonal &amp; more <span class="arrow-link__ico">&#8594;</span>
      </a>
    </div>

    <ul class="flags__list">
      {
        flagships.map((beer, i) => (
          <li class="beer" data-reveal="up" data-stagger={i}>
            <div class="beer__id">
              <h3 class="beer__name display">{beer.name}</h3>
              <p class="beer__spec">{beer.spec}</p>
            </div>

            <p class="beer__body">{beer.body}</p>

            <ul class="beer__awards">
              {
                beer.awards.map((a) => (
                  <li class="beer__award">{a}</li>
                ))
              }
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .flags__h2 {
    font-size: var(--t-h2);
  }

  .flags__list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  /* name | tasting note | awards — the artboard's row, not a card grid */
  .beer {
    display: grid;
    grid-template-columns: 26.25rem minmax(0, 1fr) 18.75rem;
    gap: 2rem;
    align-items: start;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
    transition:
      background-color 0.4s var(--ease),
      padding-left 0s;
  }

  .beer:hover {
    background: var(--paper);
  }

  .beer__id {
    min-width: 0;
  }

  .beer__name {
    margin: 0;
    font-size: var(--t-30);
    line-height: 1;
    transition: color 0.35s var(--ease);
  }

  .beer:hover .beer__name {
    color: var(--accent);
  }

  .beer__spec {
    margin: 0.5rem 0 0;
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .beer__body {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  .beer__awards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    align-items: flex-start;
  }

  .beer__award {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.625rem;
    background: var(--navy);
    color: var(--cream);
    font-size: var(--t-11);
    font-weight: 700;
    letter-spacing: var(--ls-caps-wide);
    text-transform: uppercase;
  }

  @media (max-width: 68.75rem) {
    .beer {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.875rem;
    }
    .beer:hover {
      background: transparent;
    }
    .beer__awards {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
