---
import { gallery } from '../data/brewery';
---

<section class="gal section section--pad" aria-labelledby="gal-title">
  <div class="wrap">
    <div class="gal__head">
      <p class="eyebrow" data-reveal="up">From the brewery</p>
      <h2 class="display gal__h2" id="gal-title" data-reveal="up">Gallery</h2>
    </div>

    <ul class="gal__strip">
      {
        gallery.map((shot, i) => (
          <li class="shot" data-reveal="up" data-stagger={i}>
            <img class="shot__img" src={shot.src} alt={shot.alt} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gal__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .gal__h2 {
    font-size: var(--t-h2);
  }

  .gal__strip {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .shot {
    overflow: hidden;
    background: var(--sand);
  }

  .shot__img {
    width: 100%;
    height: 12.5rem; /* 200px */
    object-fit: cover;
    transition:
      transform 0.8s var(--ease),
      filter 0.5s var(--ease);
  }

  /* A strip of six reads as one field, so the hover lifts a single frame out
     of it rather than animating the whole row. */
  .shot:hover .shot__img {
    transform: scale(1.08);
  }

  .gal__strip:hover .shot__img {
    filter: saturate(0.75) brightness(0.92);
  }

  .gal__strip:hover .shot:hover .shot__img {
    filter: none;
  }

  @media (max-width: 68.75rem) {
    .gal__strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .gal__strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shot__img {
      height: 9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot:hover .shot__img {
      transform: none;
    }
  }
</style>
