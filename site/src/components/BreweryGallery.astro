---
import { gallery } from '../data/brewery';
import { social } from '../data/site';
import Icon from './Icon.astro';

/**
 * Gallery, built to the supplied reference: heading left with a small link
 * opposite, then a band of portrait cards running edge to edge and drifting
 * sideways without stopping.
 *
 * The motion is a CSS animation rather than a transform written per frame.
 * The sequence is fixed and repeating, which is the one case keyframes suit,
 * and it costs no main-thread work at all.
 *
 * The list is laid down twice. The animation travels exactly half the track,
 * so the frame at 100% is the frame at 0% and the loop has no seam.
 */
const instagram = social.find((s) => s.label === 'Instagram')!.href;

/* The second pass is the same photographs again, so it is kept out of the
   accessibility tree and its images carry no alt text. */
const copies = [0, 1];
---

<section class="gal section section--pad" aria-labelledby="gal-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">From the brewery</p>
        <h2 class="display gal__h2" id="gal-title" data-reveal="up">Gallery</h2>
      </div>

      <a class="arrow-link" href={instagram} target="_blank" rel="noopener" data-reveal="up">
        More on Instagram <span class="arrow-link__ico">&#8594;</span>
      </a>
    </div>
  </div>

  {/* Outside the wrap, so the band runs the full width of the window and the
      cards at either end are cut by the edge rather than by a margin. */}
  <div class="strip" data-strip>
    <div class="strip__track">
      {
        copies.map((copy) =>
          gallery.map((shot, i) => (
            <button
              class="gshot"
              type="button"
              data-lb-open={i}
              data-lb-src={shot.full}
              data-lb-alt={shot.alt}
              aria-hidden={copy === 1 ? 'true' : undefined}
              {...(copy === 1 ? { tabindex: -1 } : {})}
            >
              <img
                class="gshot__img"
                src={shot.src}
                alt={copy === 1 ? '' : shot.alt}
                width="720"
                height="900"
                loading="lazy"
                decoding="async"
              />
              {/* Purely a hover affordance, so it is kept out of the
                  accessibility tree and out of the pointer's way. */}
              <span class="gshot__view" aria-hidden="true">
                <Icon name="eye" size={26} stroke="var(--cream)" width={1.5} />
              </span>
            </button>
          )),
        )
      }
    </div>
  </div>
  {/* One panel rather than one per photograph: the source is swapped on open,
      so only the frame being looked at is ever fetched, and stepping does not
      have to close one dialog to show the next. */}
  <dialog class="lb" aria-label="Brewery gallery">
    <button class="lb__close" type="button" data-lb-close aria-label="Close image">
      <Icon name="close" size={22} stroke="var(--cream)" width={1.4} />
    </button>

    <div class="lb__stage">
      <button class="lb__nav lb__nav--prev" type="button" data-lb-step="-1" aria-label="Previous image">
        <Icon name="chevron-left" size={30} stroke="var(--cream)" width={1.25} />
      </button>

      <img class="lb__img" data-lb-img src="" alt="" decoding="async" />

      <button class="lb__nav lb__nav--next" type="button" data-lb-step="1" aria-label="Next image">
        <Icon name="chevron-right" size={30} stroke="var(--cream)" width={1.25} />
      </button>
    </div>
  </dialog>
</section>

<style>
  .gal__h2 {
    font-size: var(--t-h2);
  }

  .strip {
    margin-top: 2.5rem;
    overflow: hidden;
  }

  .strip__track {
    display: flex;
    width: max-content;
    animation: gal-slide var(--dur) linear infinite;
  }

  /*
   * Speed is held across breakpoints rather than duration: the track is
   * shorter on a phone, so the same duration would drag. Each pair below is
   * one card plus its gap, times the six cards, divided by 50px a second.
   *
   *   desktop  6 x (320 + 16) = 2016px  ->  40.3s
   *   tablet   6 x (240 + 16) = 1536px  ->  30.7s
   *   phone    6 x (176 + 12) = 1128px  ->  22.6s
   */
  .strip {
    --card: 20rem;
    --gap: 1rem;
    --dur: 40.3s;
  }

  /* The gap lives on the cards, not the track. With `gap` on a track holding
     two copies, half of one gap falls inside the 50% travel and the loop slips
     by that much every cycle. */
  .gshot {
    position: relative;
    /* A button now, so the UA's chrome comes off. */
    padding: 0;
    border: 0;
    background: var(--sand);
    font: inherit;
    color: inherit;
    cursor: pointer;
    display: block;
    margin: 0 var(--gap) 0 0;
    flex: none;
    width: var(--card);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
  }

  .gshot__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * The band already stops when the pointer is on it, so the frame under the
   * cursor is still when this appears over it.
   *
   * The wash is what makes the mark legible rather than decoration. Measured
   * against the brightest 0.1% of each of the six: cream straight onto the
   * photograph is 1.08:1, invisible; 0.45 reaches only 2.42; 0.58 gets to
   * 3.53, clearing the 3:1 WCAG asks of a graphic.
   */
  .gshot__view {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(24, 33, 44, 0.58);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease);
  }

  .gshot:hover .gshot__view {
    opacity: 1;
  }

  .gshot__view :global(svg) {
    transform: scale(0.9);
    transition: transform 0.35s var(--ease);
  }

  .gshot:hover .gshot__view :global(svg) {
    transform: scale(1);
  }

  /* --- The opened frame ------------------------------------------------- */

  /*
   * Same mechanism as the show panel on the calendar: a native dialog, its
   * surface and backdrop sharing one curve and one duration, with
   * allow-discrete so it animates out instead of vanishing.
   *
   * Transparent rather than the calendar's paper, because there is nothing in
   * here but the photograph -- a panel behind it would only be a frame around
   * a frame. The backdrop goes heavier than the calendar's 0.62 to make up for
   * the surface that is no longer there.
   */
  .lb {
    /* No position here. The UA gives dialog:modal position: fixed, which both
       centres it and is already a containing block for the close button;
       overriding it to relative drops the panel into normal flow at the top of
       the body and the page jumps there when it opens. */
    width: min(72rem, calc(100vw - 2.5rem));
    max-width: none;
    max-height: calc(100vh - 3rem);
    /* Leaves the row the close button sits in, so it never rides over the
       picture where its stroke could land on a bright patch. */
    padding: 2.75rem 0 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lb::backdrop {
    background: rgba(14, 20, 28, 0.84);
  }

  .lb,
  .lb::backdrop {
    opacity: 0;
    transition:
      opacity 0.24s var(--ease),
      transform 0.24s var(--ease),
      overlay 0.24s var(--ease) allow-discrete,
      display 0.24s var(--ease) allow-discrete;
  }

  .lb {
    transform: scale(0.97);
  }

  .lb[open],
  .lb[open]::backdrop {
    opacity: 1;
  }

  .lb[open] {
    transform: scale(1);
  }

  @starting-style {
    .lb[open],
    .lb[open]::backdrop {
      opacity: 0;
    }

    .lb[open] {
      transform: scale(0.97);
    }
  }

  .lb__stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
  }

  .lb__img {
    display: block;
    margin-inline: auto;
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Light, as asked: a thin stroke and no chip behind it. They sit in the
     gutter either side of the photograph rather than on it, so the mark is
     always against the backdrop -- cream on that is about 7:1, where over a
     bright picture it would have been nearer 1. */
  .lb__nav,
  .lb__close {
    padding: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    display: grid;
    place-items: center;
    opacity: 0.75;
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .lb__nav:hover,
  .lb__close:hover {
    opacity: 1;
  }

  .lb__nav--prev:hover {
    transform: translateX(-0.1875rem);
  }

  .lb__nav--next:hover {
    transform: translateX(0.1875rem);
  }

  /* Clear of the picture, which can run to the full height. */
  .lb__close {
    position: absolute;
    top: 0;
    right: 0;
  }

  @media (max-width: 40rem) {
    /* No gutter to put them in at this width, so they step under the picture
       instead of sitting over its edges where the stroke could land on a
       bright patch. */
    .lb__stage {
      grid-template-columns: repeat(2, auto);
      grid-template-areas:
        'img img'
        'prev next';
      justify-content: center;
      gap: 0.75rem 2.5rem;
    }

    .lb__img {
      grid-area: img;
      max-height: calc(100vh - 9rem);
    }

    .lb__nav--prev {
      grid-area: prev;
    }

    .lb__nav--next {
      grid-area: next;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb,
    .lb::backdrop,
    .lb__nav,
    .lb__close {
      transition: none;
    }

    .lb,
    .lb[open] {
      transform: none;
    }
  }

  /* Exactly half the track is one full copy plus its trailing gap, so the
     frame at 100% is the frame at 0%. */
  @keyframes gal-slide {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Holds still while someone is looking at a frame, and while the band is off
     screen -- a loop burns the compositor with nothing on screen to show for
     it. Paused rather than stopped, so it picks up where it left off. */
  .strip:hover .strip__track,
  .strip[data-visible='false'] .strip__track {
    animation-play-state: paused;
  }

  @media (max-width: 68.75rem) {
    .strip {
      --card: 15rem;
      --dur: 30.7s;
    }
  }

  @media (max-width: 36rem) {
    .strip {
      --card: 11rem;
      --gap: 0.75rem;
      --dur: 22.6s;
    }
  }

  /* No drift for anyone who asked for less motion. The band becomes a row they
     scroll themselves, and the second pass goes, so it is six photographs
     rather than twelve. */
  @media (prefers-reduced-motion: reduce) {
    /* The mark still appears -- it is the affordance, not the motion -- but it
       arrives rather than grows. */
    .gshot__view,
    .gshot__view :global(svg) {
      transition: none;
    }

    .gshot:hover .gshot__view :global(svg) {
      transform: scale(1);
    }

    .strip {
      overflow-x: auto;
    }

    .strip__track {
      animation: none;
    }

    .gshot[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  const strip = document.querySelector<HTMLElement>('[data-strip]');

  if (strip && 'IntersectionObserver' in window) {
    strip.dataset.visible = 'true';
    new IntersectionObserver(
      ([entry]) => {
        strip.dataset.visible = entry.isIntersecting ? 'true' : 'false';
      },
      { rootMargin: '120px' },
    ).observe(strip);
  }
</script>
