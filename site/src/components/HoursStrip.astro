---
import Icon from './Icon.astro';
import { hoursStrip } from '../data/site';
---

<section class="strip" id="visit" aria-label="Hours, location and live music">
  <div class="strip__inner wrap">
    {
      hoursStrip.map((item, i) => (
        <div class="strip__item" data-reveal="up" data-stagger={i}>
          <Icon name={item.icon as any} size={24} />
          <div class="strip__text">
            <span class="label">{item.label}</span>
            {item.href ? (
              <a class="strip__value strip__value--link" href={item.href} target="_blank" rel="noopener">
                {item.value}
                <span class="arrow-link__ico">&#8594;</span>
              </a>
            ) : (
              <span class="strip__value">{item.value}</span>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .strip {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .strip__inner {
    min-height: 7.5rem; /* 120px */
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    padding-block: 1.5rem;
  }

  .strip__item {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .strip__item > :global(svg) {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .strip__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .strip__value {
    font-size: var(--t-17);
    font-weight: 600;
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  .strip__value--link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--accent);
    min-height: 1.75rem;
  }

  .strip__value--link:hover .arrow-link__ico {
    transform: translateX(0.375rem);
  }

  @media (max-width: 68.75rem) {
    .strip__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 2rem;
    }
  }

  @media (max-width: 36rem) {
    .strip__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
