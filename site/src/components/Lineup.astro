---
import { lineup, lineupFilters } from '../data/distillery';
---

<section class="lineup section section--pad" id="lineup" aria-labelledby="lineup-title" data-lineup>
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">Tasting profiles</p>
        <h2 class="display lineup__h2" id="lineup-title" data-reveal="up">The lineup</h2>
      </div>

      <div class="filters" role="group" aria-label="Filter the lineup" data-reveal="up">
        {
          lineupFilters.map((f) => (
            <button
              class:list={['filter', { 'is-on': f.id === 'all' }]}
              type="button"
              data-filter={f.id}
              aria-pressed={f.id === 'all' ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </div>

    <p class="vh" role="status" aria-live="polite" data-lineup-status>
      {lineup.length} of {lineup.length} spirits shown
    </p>

    <div class="lineup__grid">
      {
        lineup.map((s, i) => (
          <article class="bottle" data-group={s.group} data-reveal="up" data-stagger={i % 4}>
            <span class="bottle__media">
              <img class="bottle__img" src={s.image} alt={s.alt} loading="lazy" />
            </span>
            <div class="bottle__body">
              <span class:list={['bottle__badge', `bottle__badge--${s.badgeTone}`]}>{s.badge}</span>
              <h3 class="bottle__name display">{s.name}</h3>
              <p class="bottle__note">{s.note}</p>
              <p class="bottle__foot">
                <span class="bottle__price">{s.price}</span>
                <span class="bottle__avail">{s.availability}</span>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lineup__h2 {
    font-size: var(--t-h2);
  }

  /* --- Filters ---------------------------------------------------------- */

  .filters {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .filter {
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    border: 1.5px solid var(--navy);
    background: transparent;
    color: var(--navy);
    /* Montserrat, set in caps at its regular weight. Caps at this size need
       the tracking opened a little or the words run together; --ls-caps-sm is
       the scale's step for exactly that, caps at 14px and up. */
    font-family: var(--font-sub);
    font-weight: 400;
    font-size: var(--t-14);
    letter-spacing: var(--ls-caps-sm);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .filter:hover {
    background: var(--sand);
  }

  .filter.is-on,
  .filter.is-on:hover {
    background: var(--navy);
    color: var(--cream);
  }

  /* --- Grid ------------------------------------------------------------- */

  .lineup__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .bottle {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule);
    transition: transform 0.45s var(--ease);
  }

  .bottle:hover {
    transform: translateY(-0.375rem);
  }

  .bottle[hidden] {
    display: none;
  }

  .bottle__media {
    display: block;
    /* Product shots on white - contain them on a sand field rather than
       cropping, which is what the artboard does. */
    background: #e4daca;
    padding: 1rem;
  }

  .bottle__img {
    width: 100%;
    height: 18.75rem; /* 300px */
    object-fit: contain;
    transition: transform 0.6s var(--ease);
  }

  .bottle:hover .bottle__img {
    transform: scale(1.04);
  }

  .bottle__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .bottle__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 1.625rem;
    padding: 0.25rem 0.625rem;
    font-size: var(--t-11);
    font-weight: 700;
    letter-spacing: var(--ls-caps-wide);
    text-transform: uppercase;
    color: var(--white);
  }

  .bottle__badge--navy {
    background: var(--navy);
  }
  .bottle__badge--accent {
    background: var(--accent);
  }
  .bottle__badge--muted {
    background: #6b6f75;
  }

  .bottle__name {
    font-size: var(--t-28);
    line-height: 1;
    margin: 0;
  }

  .bottle__note {
    margin: 0;
    font-size: var(--t-14);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  .bottle__foot {
    margin: auto 0 0;
    padding-top: 0.875rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .bottle__price {
    font-size: var(--t-lead);
    font-weight: 700;
  }

  .bottle__avail {
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 68.75rem) {
    .lineup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .lineup__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
