---
import Icon from './Icon.astro';
import { goodToKnow } from '../data/restaurant';
---

<section class="dnotes on-navy" aria-label="Before you visit">
  <div class="dnotes__inner wrap">
    {
      goodToKnow.map((n, i) => (
        <div class="dnote" data-reveal="up" data-stagger={i}>
          <Icon name={n.icon} size={30} stroke="var(--brass)" width={1.5} />
          <h2 class="dnote__title display display--700">{n.title}</h2>
          <p class="dnote__body">{n.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .dnotes {
    background: var(--navy);
    color: var(--cream);
  }

  .dnotes__inner {
    min-height: 18.75rem; /* 300px */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    align-items: start;
    padding-block: 3.5rem;
  }

  .dnote {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-top: 1px solid var(--rule-navy);
    padding-top: 1.5rem;
    min-width: 0;
    transition: border-color 0.5s var(--ease);
  }

  .dnote:hover {
    border-color: var(--brass);
  }

  .dnote__title {
    margin: 0;
    font-size: var(--t-28);
    line-height: 1;
  }

  .dnote__body {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--on-navy-2);
  }

  @media (max-width: 68.75rem) {
    .dnotes__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
