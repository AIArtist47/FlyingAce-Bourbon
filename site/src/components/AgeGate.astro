---
import { img } from '../data/site';

/**
 * 21+ age gate, built from the AgeGate artboards.
 *
 * A client-side overlay over the page that was asked for, on every page
 * including deep links -- no redirect, and nothing withheld server-side, which
 * is what the canvas build notes ask for so crawlers still read the pages.
 *
 * The build notes also describe a "remember me" that sets a 30-day cookie.
 * That is deliberately left out: there is no checkbox and no cookie, only a
 * sessionStorage flag, so the answer lasts the browsing session and no longer.
 */
---

<dialog class="gate" aria-labelledby="gate-ask-title">
  <span class="gate__bg" style={`background-image: url('${img.heroPoster}')`} aria-hidden="true"
  ></span>
  <span class="gate__scrim" aria-hidden="true"></span>

  <div class="gate__card">
    <img class="gate__mark" src={img.logo} alt="" width="72" height="72" />
    <p class="gate__brand display">Flying Ace Farm</p>

    <div class="gate__step" data-gate-step="ask">
      <h2 class="display gate__h" id="gate-ask-title" tabindex="-1">Are you 21 or older?</h2>
      <p class="gate__lede">You must be of legal drinking age to enter this site.</p>
      <div class="gate__actions">
        <button class="btn btn--solid btn--xl gate__btn" type="button" data-gate="yes">
          Yes, I’m 21+
        </button>
        <button class="btn btn--ghost btn--xl gate__btn" type="button" data-gate="no">No</button>
      </div>
    </div>

    <div class="gate__step" data-gate-step="deny" hidden>
      <h2 class="display gate__h gate__h--deny" id="gate-deny-title" tabindex="-1">
        Sorry - come back when you’re 21
      </h2>
      <p class="gate__lede">
        This site features alcoholic beverages and is intended for guests of legal drinking age.
      </p>
      <button class="btn btn--ghost btn--md" type="button" data-gate="back">
        I entered the wrong answer
      </button>
    </div>

    <p class="gate__foot">
      Please enjoy American Ace Spirits and Flying Ace beer responsibly.
    </p>
  </div>
</dialog>

<script is:inline>
  /*
   * Deliberately inline and un-deferred, sitting directly after the dialog: it
   * runs while the body is still parsing, so the gate is up before anything
   * behind it paints rather than flashing the page and then covering it.
   *
   * The dialog is closed in the markup and only ever opened from here, so a
   * visitor without JS -- and a crawler that does not run it -- gets the page
   * rather than a wall they could never dismiss.
   */
  (function () {
    var gate = document.querySelector('.gate');
    if (!gate || typeof gate.showModal !== 'function') return;

    var KEY = 'fa-age-ok';
    try {
      if (sessionStorage.getItem(KEY) === '1') return;
    } catch (e) {
      /* Blocked storage throws on read. Ask again rather than wave anyone
         through, and accept that the answer will not stick. */
    }

    var ask = gate.querySelector('[data-gate-step="ask"]');
    var deny = gate.querySelector('[data-gate-step="deny"]');

    function show(declined) {
      ask.hidden = declined;
      deny.hidden = !declined;
      /* The label has to follow, or it points at a hidden heading. */
      gate.setAttribute('aria-labelledby', declined ? 'gate-deny-title' : 'gate-ask-title');
      /* Focus the heading rather than the button, so the answer that just
         landed is what gets read out, with its action next in the order. */
      (declined ? deny : ask).querySelector('h2').focus();
    }

    gate.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-gate]');
      if (!btn) return;
      var action = btn.getAttribute('data-gate');

      if (action === 'no') return show(true);
      if (action === 'back') return show(false);

      try {
        sessionStorage.setItem(KEY, '1');
      } catch (e2) {}
      gate.close();
      /* Smooth scroll is paused while this is up; this is what resumes it. */
      document.dispatchEvent(new CustomEvent('fa:gate-cleared'));
    });

    /* Escape would otherwise close it without an answer. */
    gate.addEventListener('cancel', function (e) {
      e.preventDefault();
    });

    gate.showModal();
  })();
</script>

<style>
  /* Scoped to [open] on purpose. A bare `display` here would beat the UA's
     `dialog:not([open]) { display: none }`, and the gate would render for
     everyone who had already answered -- un-dismissable, since the script
     returns before it binds anything. */
  .gate[open] {
    display: grid;
    place-items: center;
  }

  .gate {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    /* Shows through for the moment before the photograph arrives, so the card
       never lands on white. */
    background: var(--navy);
    color: var(--ink);
  }

  .gate::backdrop {
    background: var(--navy);
  }

  /* A background rather than an <img>: a closed dialog is display:none, and a
     background in a display:none subtree is never fetched, so a visitor who
     has already answered this session does not pay for the photograph. */
  .gate__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .gate__scrim {
    position: absolute;
    inset: 0;
    background: rgba(14, 20, 28, 0.78);
  }

  .gate__card {
    position: relative;
    width: min(35rem, calc(100% - 2.5rem));
    max-height: calc(100% - 2.5rem);
    overflow-y: auto;
    box-sizing: border-box;
    padding: 3.5rem 3.5rem 2.75rem;
    background: var(--cream);
    border-top: 6px solid var(--accent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .gate__mark {
    width: 4.5rem;
    height: 4.5rem;
    flex-shrink: 0;
    object-fit: contain;
    background: var(--navy);
    border-radius: 50%;
    box-sizing: border-box;
    padding: 0.375rem;
  }

  .gate__brand {
    margin: 0;
    font-size: var(--t-17);
    letter-spacing: var(--ls-label);
  }

  .gate__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
  }

  .gate__step[hidden] {
    display: none;
  }

  .gate__h:focus {
    outline: none;
  }

  .gate__h {
    margin: 0;
    font-size: var(--t-h2-sm);
    line-height: var(--lh-hero);
  }

  /* The longer line, dropped a step so it does not run to three. */
  .gate__h--deny {
    font-size: var(--t-h2-news);
  }

  .gate__lede {
    margin: 0;
    font-size: var(--t-16);
    line-height: var(--lh-body);
    color: var(--muted);
  }

  .gate__actions {
    display: flex;
    gap: 0.75rem;
    width: 100%;
  }

  .gate__btn {
    flex: 1;
  }

  .gate__foot {
    margin: 0;
    width: 100%;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--t-12);
    line-height: 1.5;
    color: var(--muted-2);
  }

  /* Matches the mobile artboard: tighter card, smaller roundel, buttons
     stacked so neither answer is cramped. */
  @media (max-width: 30rem) {
    .gate__card {
      padding: 2.25rem 1.5rem;
    }

    .gate__mark {
      width: 3.75rem;
      height: 3.75rem;
      padding: 0.3125rem;
    }

    .gate__actions {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gate .btn:hover {
      transform: none;
    }
  }
</style>
