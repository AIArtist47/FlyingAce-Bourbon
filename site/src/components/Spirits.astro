---
/**
 * "First farm distillery and brewery" — four cards describing the farm.
 *
 * Keeps `id="spirits"`: the header's Order Spirits (bar + drawer), the hero's
 * Explore Our Spirits, the Distillery nav item and the Distillery pillar card
 * all point here.
 *
 * Laid out 2×2 rather than 4-across on purpose. Three sections on this page
 * already run a four-column row, so repeating it would blur them together —
 * and the fourth card's copy is far longer than the rest, which a wide-and-
 * shallow column handles badly.
 *
 * Copy is verbatim as supplied.
 */

const cards = [
  {
    num: '01',
    title: 'The Experience',
    body: 'Views of Furnace Mountain. Live music every Friday, Saturday and Sunday. A working farm surrounded by over 60 acres of Bloody Butcher cornfields.',
  },
  {
    num: '02',
    title: 'The Farm',
    body: 'Farm-to-table and farm-to-bottle specialties produced on the 200-year-old working farm.',
  },
  {
    num: '03',
    title: 'The Spirits & Beer',
    body: 'A distillery already making history. A world-class brewery. And an on-site Virginia ABC store … so you can take home more than memories.',
  },
  {
    num: '04',
    title: 'The Food',
    body: 'Monk’s on the Farm Restaurant is serving up some of American’s best Southern barbeque, including weekly specials and a “Burger & Beer” special every Thursday as well as a Fried Chicken Friday special. Check out our menu located under the menu tab.',
  },
];
---

<section class="story section section--pad" id="spirits" aria-labelledby="story-title">
  <div class="wrap">
    <header class="story__head">
      <p class="eyebrow" data-reveal="up">Loudoun County’s</p>
      <h2 class="display story__h2" id="story-title" data-reveal="up">
        First farm distillery and brewery
      </h2>
    </header>

    <div class="story__grid">
      {
        cards.map((card, i) => (
          <article class="facet" data-reveal="up" data-stagger={i}>
            <span class="facet__rule" aria-hidden="true" />
            <p class="facet__num display" aria-hidden="true">
              {card.num}
            </p>
            <h3 class="facet__title display display--700">{card.title}</h3>
            <p class="facet__body">{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .story {
    border-top: 1px solid var(--rule);
  }

  .story__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .story__h2 {
    font-size: var(--t-h2);
  }

  .story__grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* --- Card ------------------------------------------------------------- */

  .facet {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-height: 18rem;
    padding: 2.25rem;
    background: var(--paper);
    /* Sharp corners, as everywhere else in this system. */
    border: 1px solid var(--rule);
    transition:
      background-color 0.45s var(--ease),
      border-color 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .facet:hover {
    background: var(--navy);
    border-color: var(--navy);
    transform: translateY(-0.375rem);
  }

  /* Brass rule drawing across the top — scaleX, so no layout per frame. */
  .facet__rule {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s var(--ease);
  }

  .facet:hover .facet__rule {
    transform: scaleX(1);
  }

  .facet__num {
    font-size: var(--t-26);
    letter-spacing: 0.2em;
    line-height: 1;
    margin: 0;
    color: var(--rule);
    transition: color 0.45s var(--ease);
  }

  .facet:hover .facet__num {
    color: var(--brass);
  }

  .facet__title {
    font-size: var(--t-34);
    line-height: 1;
    margin: 0;
    transition: color 0.45s var(--ease);
  }

  .facet:hover .facet__title {
    color: var(--cream);
  }

  .facet__body {
    margin: 0;
    font-size: var(--t-16);
    line-height: var(--lh-tight);
    color: var(--muted);
    max-width: 34rem;
    transition: color 0.45s var(--ease);
  }

  .facet:hover .facet__body {
    color: var(--on-navy-2);
  }

  /* --- Breakpoints ------------------------------------------------------ */

  @media (max-width: 48rem) {
    .story__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.5rem;
    }

    .facet {
      min-height: 0;
      padding: 1.75rem;
    }
  }

  /* Hover lift is the only motion here; the colour change carries the state
     on its own for anyone who asked for less movement. */
  @media (prefers-reduced-motion: reduce) {
    .facet:hover {
      transform: none;
    }
  }
</style>
