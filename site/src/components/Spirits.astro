---
const cards = [
  {
    num: '01',
    title: 'The Experience',
    body: 'Views of Furnace Mountain. Live music every Friday, Saturday and Sunday. A working farm surrounded by over 60 acres of Bloody Butcher cornfields.',
  },
  {
    num: '02',
    title: 'The Farm',
    body: 'Farm-to-table and farm-to-bottle specialties produced on the 200-year-old working farm.',
  },
  {
    num: '03',
    title: 'The Spirits & Beer',
    body: 'A distillery already making history. A world-class brewery. And an on-site Virginia ABC store … so you can take home more than memories.',
  },
  {
    num: '04',
    title: 'The Food',
    body: 'Monk’s on the Farm Restaurant is serving up some of American’s best Southern barbeque, including weekly specials and a “Burger & Beer” special every Thursday as well as a Fried Chicken Friday special.',
  },
];

/**
 * One photograph per card, in the cards' own order: the farm, what it grows,
 * what it makes, what it serves. Each is cover-fitted across the whole section
 * and then a diagonal slice of it is shown, so the four read as one picture cut
 * into bands rather than as four thumbnails.
 *
 * They are decorative -- every word the section carries is in the cards -- so
 * they take an empty alt and the strip is hidden from the accessibility tree.
 */
const panels = [
  { src: '/images/collage/farm.webp', w: 960, h: 539 },
  { src: '/images/collage/grain.webp', w: 1440, h: 1920 },
  { src: '/images/collage/aircraft.webp', w: 1920, h: 1280 },
  { src: '/images/collage/monks.webp', w: 1920, h: 1080 },
];
---

<section class="story section section--pad on-navy" id="spirits" aria-labelledby="story-title">
  <div class="collage" aria-hidden="true">
    {
      panels.map((p, i) => (
        <div class="collage__band" style={`--i:${i}`}>
          <img
            class="collage__img"
            src={p.src}
            alt=""
            width={p.w}
            height={p.h}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </div>

  {/* The cards are opaque, so their own text never depends on what is behind
      them. This carries the heading instead, and settles four bright
      photographs into one tonal field so the cards stay the loudest thing. */}
  <div class="story__scrim" aria-hidden="true"></div>

  <div class="wrap story__inner">
    <header class="story__head">
      <p class="eyebrow eyebrow--brass" data-reveal="up">Loudoun County’s</p>
      <h2 class="display story__h2" id="story-title" data-reveal="up">
        First farm distillery and brewery
      </h2>
    </header>

    <div class="story__grid">
      {
        cards.map((card, i) => (
          <article class="facet" data-reveal="up" data-stagger={i}>
            <span class="facet__rule" aria-hidden="true" />
            <p class="facet__num display" aria-hidden="true">
              {card.num}
            </p>
            <h3 class="facet__title display display--700">{card.title}</h3>
            <p class="facet__body">{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--navy);
    /* The Experience section below is navy too, so without this the collage
       just stops mid-air and the join reads as a glitch. A hairline is what
       the rest of the site uses to divide dark from dark. */
    border-bottom: 1px solid var(--rule-navy);
  }

  /*
   * Deeper than the --sec-y every other section runs, because this is the one
   * section whose background is the point. Widening the card gutters alone
   * barely helps -- the section grows by about what the gutters add, so the
   * share of collage on show moves a point per rem. Padding adds open ground
   * without adding card, which is what actually opens the picture up: 50% of
   * the section visible at the old spacing, 58% at this one. Resolves to 160px
   * at a 1440 viewport, like every other size in this system.
   */
  .story.section--pad {
    padding-block: clamp(4.5rem, 11.1111vw, 10rem);
  }

  .story__inner {
    position: relative;
    z-index: 2;
  }

  /* --- Collage ---------------------------------------------------------- */

  /*
   * Four bands sheared to a single angle. The shear is a transform rather than
   * a percentage clip-path on purpose: a polygon in percentages takes its angle
   * from the box it is in, so the same declaration would stand near-vertical on
   * a tall phone and near-flat on a wide desktop. skewX holds 16deg everywhere.
   *
   * Shearing leaves a triangular void at each end, so the strip is pulled wider
   * than the section and the section clips it.
   */
  .collage {
    position: absolute;
    inset: 0 calc(-1 * var(--shear-room));
    z-index: 0;
    display: flex;
    gap: 0.625rem;
    /* Both voids a shear opens -- the triangle at each end of the strip, and
       the corner the counter-shear pulls off each photograph -- are
       (height / 2) * tan(16deg). They grow with the section's height, not its
       width, and the phone layout is the tall one: four stacked cards run to
       about 2000px against the desktop's 1030. One value covers both ends of
       that, so it is set once rather than per breakpoint. */
    --shear-room: 24rem;
  }

  .collage__band {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    overflow: hidden;
    transform: skewX(-16deg);
  }

  /*
   * Counter-sheared so the photograph itself stands straight. The counter-shear
   * uncovers the band's corners, so the picture is laid out wider than the band
   * and centred, which is also what lets object-fit crop rather than squash.
   */
  .collage__img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1 * var(--shear-room));
    width: calc(100% + 2 * var(--shear-room));
    /* The reset caps every image at max-width: 100%, which would clamp that
       width straight back to the band and strand the corners the counter-shear
       pulls off. */
    max-width: none;
    height: 100%;
    object-fit: cover;
    transform: skewX(16deg);
  }

  .story__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Flat rather than a gradient: the cards sit across the whole height, so
       there is no one edge the text needs lifting off. 0.84 keeps the heading
       above 7:1 even where a band is blown out. */
    background: rgba(24, 33, 44, 0.84);
  }

  /* --- Head ------------------------------------------------------------- */

  .story__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 48rem;
  }

  .story__h2 {
    font-size: var(--t-h2);
    color: var(--cream);
  }

  .story__grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Wider than the 1.5rem the cards carried on cream: the gutters are the
       collage's main window now, so they are sized to show it. */
    gap: 3.5rem;
  }

  /* --- Card ------------------------------------------------------------- */

  .facet {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-height: 18rem;
    padding: 2.25rem;
    background: var(--paper);
    /* Sharp corners, as everywhere else in this system. */
    border: 1px solid var(--rule);
    transition:
      background-color 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  /* The border holds the light --rule it starts at rather than following the
     fill to navy, which is what keeps the card's edge legible against the
     collage once it darkens. */
  .facet:hover {
    background: var(--navy);
    transform: translateY(-0.375rem);
  }

  /* Brass rule drawing across the top — scaleX, so no layout per frame. */
  .facet__rule {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 2px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s var(--ease);
  }

  .facet:hover .facet__rule {
    transform: scaleX(1);
  }

  .facet__num {
    font-size: var(--t-26);
    letter-spacing: var(--ls-wordmark);
    line-height: 1;
    margin: 0;
    color: var(--rule);
    transition: color 0.45s var(--ease);
  }

  .facet:hover .facet__num {
    color: var(--brass);
  }

  .facet__title {
    font-size: var(--t-34);
    line-height: 1;
    margin: 0;
    transition: color 0.45s var(--ease);
  }

  .facet:hover .facet__title {
    color: var(--cream);
  }

  .facet__body {
    margin: 0;
    font-size: var(--t-16);
    line-height: var(--lh-tight);
    color: var(--muted);
    max-width: 34rem;
    transition: color 0.45s var(--ease);
  }

  .facet:hover .facet__body {
    color: var(--on-navy-2);
  }

  /* --- Breakpoints ------------------------------------------------------ */

  /* Four bands across a phone would be 80px slivers with nothing readable in
     them, so the count drops with the width and the survivors widen to fill. */
  @media (max-width: 68.75rem) {
    .collage__band:nth-child(4) {
      display: none;
    }
  }

  @media (max-width: 48rem) {
    .story__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.5rem;
    }

    .facet {
      min-height: 0;
      padding: 1.75rem;
    }

    .collage__band:nth-child(3) {
      display: none;
    }
  }

  /* Hover lift is the only motion here; the colour change carries the state
     on its own for anyone who asked for less movement. */
  @media (prefers-reduced-motion: reduce) {
    .facet:hover {
      transform: none;
    }
  }
</style>
