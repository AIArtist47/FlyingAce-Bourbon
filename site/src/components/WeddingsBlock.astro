---
import { weddings as w } from '../data/events';
---

<section class="wed on-navy" id="weddings" aria-labelledby="wed-title">
  <div class="wed__inner wrap">
    <div class="wed__media" data-reveal="up">
      <img class="wed__img" src={w.image} alt={w.alt} width="980" height="653" loading="lazy" decoding="async" />
      {/* The bridal suite tucked into the corner: the detail that sells the
          farmhouse, without giving it a row of its own. */}
      <img
        class="wed__inset"
        src={w.inset}
        alt={w.insetAlt}
        width="980"
        height="653"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="wed__copy">
      <p class="eyebrow eyebrow--brass" data-reveal="up">{w.eyebrow}</p>
      <h2 class="display wed__h2" id="wed-title" data-reveal="up">{w.title}</h2>
      <p class="wed__text" data-reveal="up">{w.body}</p>
      <div class="wed__cta" data-reveal="up">
        <a class="btn btn--solid" href={w.href}>{w.cta}</a>
        <a class="wed__mail tap-box" href={`mailto:${w.email}`}>{w.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .wed {
    background: var(--navy);
    color: var(--cream);
  }

  .wed__inner {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 4rem;
    align-items: center;
    padding-block: var(--sec-y);
  }

  .wed__media {
    position: relative;
    min-width: 0;
    /* Room at the bottom-right for the inset to sit outside the main frame. */
    padding: 0 3.5rem 3.5rem 0;
  }

  .wed__img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .wed__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 0.5rem solid var(--navy);
  }

  .wed__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    --stack-gap: 1rem;
    gap: var(--stack-gap);
    min-width: 0;
  }

  .wed__h2 {
    margin: 0;
    font-size: var(--t-h2-sm);
    color: var(--cream);
  }

  .wed__text {
    margin: 0;
    max-width: 44ch;
    font-size: var(--t-17);
    line-height: var(--lh-body);
    color: var(--on-navy);
  }

  .wed__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.875rem 1.5rem;
    margin-top: 0.5rem;
  }

  .wed__mail {
    font-size: var(--t-15);
    color: var(--brass);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s var(--ease);
  }

  .wed__mail:hover {
    border-bottom-color: var(--brass);
  }

  @media (max-width: 68.75rem) {
    .wed__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .wed__media {
      padding: 0 2.5rem 2.5rem 0;
    }

    .wed__h2 {
      font-size: var(--t-44);
    }
  }
</style>
