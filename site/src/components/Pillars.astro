---
import { pillars } from '../data/site';

/* Read off the href rather than carried as a flag in the data: the only thing
   that makes a panel outbound is where it points, and a flag could disagree
   with it. */
const outbound = (href: string) => /^https?:\/\//.test(href);

/**
 * Vertical accordion hover cards.
 *
 * The felt state here is browsing, not deciding — someone weighing how to
 * spend an afternoon. The physical analogue is sliding a barn door: real
 * weight on the way open, a soft landing, no bounce. So the panel carries a
 * long ease-out and the content follows it in rather than racing it.
 *
 * Width is driven by `grid-template-columns` on the parent via `:has()`, so
 * the whole interaction is CSS — no JS, interruptible mid-flight, and
 * keyboard users get it through `:focus-within` exactly as hover users do.
 * Pointers without hover, reduced-motion readers and narrow screens all fall
 * back to a plain card grid where every panel is open.
 */
---

<section class="pillars section" aria-labelledby="pillars-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">At the farm</p>
        <h2 class="display pillars__h2" id="pillars-title" data-reveal="up">
          Bourbon, beer &amp; BBQ
        </h2>
      </div>
    </div>

    <div class="acc" data-reveal="up">
      {
        pillars.map((p) => (
          <a
            class="panel"
            id={p.id}
            href={p.href}
            target={outbound(p.href) ? '_blank' : undefined}
            rel={outbound(p.href) ? 'noopener' : undefined}
          >
            <span class="panel__media">
              <img class="panel__img" src={p.image} alt="" loading="lazy" />
            </span>
            <span class="panel__veil" />

            <span class="panel__spine" aria-hidden="true">
              <span class="panel__spine-title display display--700">{p.title}</span>
            </span>

            <span class="panel__num" aria-hidden="true">
              {p.num}
            </span>

            <span class="panel__body">
              <span class="panel__title display display--700">{p.title}</span>
              <span class="panel__lede">{p.lede}</span>
              <span class="panel__meta">
                {p.meta.map((m) => (
                  <span class="panel__tag">{m}</span>
                ))}
              </span>
              <span class="panel__cta">
                {p.cta}
                <span class="panel__arrow">&#8594;</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    padding-top: var(--sec-y);
  }

  .pillars__h2 {
    font-size: var(--t-h2);
  }

  /* ---------------------------------------------------------------------- *
   * Fallback layout: a plain grid of open cards.
   * Everything below the accordion media query builds on this, so a browser
   * without :has() — or a reader on a phone — still gets the full content.
   * ---------------------------------------------------------------------- */

  .acc {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 26rem;
    padding: 1.75rem;
    overflow: hidden;
    isolation: isolate;
    color: var(--cream);
    background: var(--navy);
  }

  .panel:hover {
    color: var(--cream);
  }

  .panel__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .panel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(14, 20, 28, 0.55);
  }

  /* The rotated spine only exists in the accordion; the grid shows titles
     horizontally like any other card. */
  .panel__spine {
    display: none;
  }

  .panel__num {
    font-family: var(--font-display);
    font-size: var(--t-14);
    font-weight: 700;
    letter-spacing: var(--ls-wordmark);
    color: var(--brass);
    margin-bottom: 0.875rem;
  }

  .panel__body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .panel__title {
    font-size: var(--t-32);
    line-height: 1;
  }

  .panel__lede {
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--hero-copy);
    max-width: 30rem;
  }

  .panel__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .panel__tag {
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--brass);
  }

  .panel__tag + .panel__tag::before {
    content: '·';
    margin-right: 1rem;
    color: rgba(217, 185, 122, 0.55);
  }

  .panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding-bottom: 0.25rem;
    font-size: var(--t-14);
    font-weight: 600;
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    color: var(--cream);
    border-bottom: 1.5px solid var(--brass);
  }

  .panel__arrow {
    display: inline-block;
    transition: transform 0.4s var(--ease);
  }

  .panel:hover .panel__arrow {
    transform: translateX(0.375rem);
  }

  @media (max-width: 68.75rem) {
    .acc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .acc {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel {
      min-height: 22rem;
    }
  }

  /* ---------------------------------------------------------------------- *
   * The accordion itself. Gated on a real hovering pointer, enough width to
   * hold four panels, and no reduced-motion request.
   * ---------------------------------------------------------------------- */

  @media (hover: hover) and (min-width: 69rem) and (prefers-reduced-motion: no-preference) {
    .acc {
      --open: 2.6fr;
      --shut: 1fr;
      grid-template-columns: var(--open) var(--shut) var(--shut) var(--shut);
      gap: 0.75rem;
      /* Opening carries weight, so it runs longer than a button would; the
         content inside is deliberately quicker and slightly behind it. */
      transition: grid-template-columns 420ms var(--ease);
    }

    .acc:has(.panel:nth-child(2):is(:hover, :focus-within)) {
      grid-template-columns: var(--shut) var(--open) var(--shut) var(--shut);
    }

    .acc:has(.panel:nth-child(3):is(:hover, :focus-within)) {
      grid-template-columns: var(--shut) var(--shut) var(--open) var(--shut);
    }

    .acc:has(.panel:nth-child(4):is(:hover, :focus-within)) {
      grid-template-columns: var(--shut) var(--shut) var(--shut) var(--open);
    }

    .panel {
      min-height: clamp(26rem, 36vw, 32.5rem);
      padding: 1.75rem;
      justify-content: flex-end;
    }

    /* Shut by default; the first panel is open until a pointer says otherwise,
       so the section never greets anyone as a row of closed doors. */
    .panel__veil {
      background: rgba(14, 20, 28, 0.74);
      transition: background-color 420ms var(--ease);
    }

    .panel__img {
      transform: scale(1.06);
      transition: transform 620ms var(--ease);
    }

    .panel__spine {
      display: flex;
      align-items: center;
      position: absolute;
      left: 1.75rem;
      bottom: 1.75rem;
      right: 1.75rem;
      opacity: 1;
      transition: opacity 200ms var(--ease);
    }

    .panel__spine-title {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: var(--t-26);
      letter-spacing: var(--ls-display);
      color: var(--cream);
      white-space: nowrap;
    }

    .panel__num {
      position: absolute;
      top: 1.75rem;
      left: 1.75rem;
      margin-bottom: 0;
      transition: color 420ms var(--ease);
    }

    .panel__body {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
      transition:
        opacity 240ms var(--ease),
        transform 240ms var(--ease);
      pointer-events: none;
    }

    /* --- Open state ----------------------------------------------------- */

    .panel:is(:hover, :focus-within) .panel__veil,
    .acc:not(:has(.panel:is(:hover, :focus-within))) .panel:first-child .panel__veil {
      background: rgba(14, 20, 28, 0.5);
    }

    .panel:is(:hover, :focus-within) .panel__img,
    .acc:not(:has(.panel:is(:hover, :focus-within))) .panel:first-child .panel__img {
      transform: scale(1);
    }

    .panel:is(:hover, :focus-within) .panel__spine,
    .acc:not(:has(.panel:is(:hover, :focus-within))) .panel:first-child .panel__spine {
      opacity: 0;
    }

    .panel:is(:hover, :focus-within) .panel__body,
    .acc:not(:has(.panel:is(:hover, :focus-within))) .panel:first-child .panel__body {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      /* Let the door get most of the way open before the copy arrives. */
      transition-delay: 150ms;
    }
  }

  /* A browser without :has() keeps the fallback grid rather than a broken
     accordion — the whole open/shut system hangs off :has(). */
  @supports not selector(:has(*)) {
    .acc {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      transition: none;
    }
  }
</style>
