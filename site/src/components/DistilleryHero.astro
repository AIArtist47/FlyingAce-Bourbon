---
import { distilleryHero } from '../data/distillery';
---

<section class="dhero on-navy" id="top">
  <div class="dhero__inner wrap">
    <div class="dhero__copy">
      <p class="eyebrow eyebrow--brass" data-reveal="up">Flying Ace Farm Distillery</p>
      <h1 class="display dhero__title" data-reveal="up">American Ace Spirits</h1>
      <p class="dhero__lede" data-reveal="up">
        Award-winning bourbon, whiskey and rum. Join us in toasting the men and women who protect
        our skies.
      </p>
      <div class="dhero__cta" data-reveal="up">
        <a class="btn btn--solid btn--lg" href="#lineup">Shop the Lineup</a>
        <a class="btn btn--ghost-light btn--lg" href="#cocktails">Cocktail Menu</a>
      </div>
    </div>

    <!-- No data-parallax here: the parallax overscales by 1.16 to keep its edges
         hidden, which would crop the propeller and the barrel racks back out. -->
    <div class="dhero__media" data-reveal="up">
      <img
        class="dhero__img"
        src={distilleryHero}
        alt="American Ace bottles on the tasting-room bar beneath the hangar propeller, barrel racks behind"
        width="2560"
        height="1440"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .dhero {
    background: var(--navy);
    color: var(--cream);
  }

  .dhero__inner {
    min-height: 30rem; /* 480px */
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding-block: var(--sec-y);
  }

  .dhero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1 1 26rem;
    max-width: 43.75rem; /* 700px */
    min-width: 0;
  }

  .dhero__title {
    /* Set tighter than the section headings, same as the home hero. */
    --cap-spill: 0.155em;
    font-size: clamp(3rem, 7.7778vw, 7rem); /* 112px @1440 */
    line-height: var(--lh-hero);
    color: var(--cream);
  }

  .dhero__lede {
    font-size: clamp(1.0625rem, 1.3194vw, 1.1875rem); /* 19px */
    line-height: var(--lh-body);
    color: var(--on-navy);
    max-width: 38rem;
  }

  .dhero__cta {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  /* The frame carries the photo's own 16:9 ratio (2560x1440), so object-fit
     has nothing left to crop: the shot shows in full and still meets all four
     edges. Sizing the frame by width and letting the ratio set the height is
     what keeps those two things true together. */
  .dhero__media {
    flex: 1 1 45rem;
    max-width: 48rem; /* 768px */
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .dhero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 68.75rem) {
    .dhero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
    }

    .dhero__copy,
    .dhero__media {
      flex: 0 0 auto;
      max-width: none;
      width: 100%;
    }

    .dhero__media {
      order: -1;
    }
  }
</style>
