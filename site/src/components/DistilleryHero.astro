---
import { distilleryHero } from '../data/distillery';
---

<section class="dhero on-navy" id="top">
  <div class="dhero__inner wrap">
    <div class="dhero__copy">
      <p class="eyebrow eyebrow--brass" data-reveal="up">Flying Ace Farm Distillery</p>
      <h1 class="display dhero__title" data-reveal="up">American Ace Spirits</h1>
      <p class="dhero__lede" data-reveal="up">
        Award-winning bourbon, whiskey and rum. Join us in toasting the men and women who protect
        our skies.
      </p>
      <div class="dhero__cta" data-reveal="up">
        <a class="btn btn--solid btn--lg" href="#lineup">Shop the Lineup</a>
        <a class="btn btn--ghost-light btn--lg" href="#cocktails">Cocktail Menu</a>
      </div>
    </div>

    <div class="dhero__media" data-reveal="up">
      <img
        class="dhero__img"
        src={distilleryHero}
        alt="American Ace bottles in the Flying Ace Farm distillery"
        width="540"
        height="360"
        fetchpriority="high"
        data-parallax="0.05"
      />
    </div>
  </div>
</section>

<style>
  .dhero {
    background: var(--navy);
    color: var(--cream);
  }

  .dhero__inner {
    min-height: 30rem; /* 480px */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    padding-block: var(--sec-y);
  }

  .dhero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 43.75rem; /* 700px */
    min-width: 0;
  }

  .dhero__title {
    /* Set tighter than the section headings, same as the home hero. */
    --cap-spill: 0.155em;
    font-size: clamp(3rem, 7.7778vw, 7rem); /* 112px @1440 */
    line-height: var(--lh-hero);
    color: var(--cream);
  }

  .dhero__lede {
    font-size: clamp(1.0625rem, 1.3194vw, 1.1875rem); /* 19px */
    line-height: var(--lh-body);
    color: var(--on-navy);
    max-width: 38rem;
  }

  .dhero__cta {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .dhero__media {
    width: 33.75rem; /* 540px */
    flex-shrink: 0;
    overflow: hidden;
    /* Fill the row instead of floating a short card inside it. The copy
       column runs taller than the artboard's 360px frame, which left a band
       of navy above and below the image; 360px is now the floor, not the
       fixed height. */
    align-self: stretch;
    min-height: 22.5rem; /* 360px */
  }

  .dhero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  @media (max-width: 68.75rem) {
    .dhero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
    }

    .dhero__media {
      width: 100%;
      order: -1;
      /* Stacked: the frame sets its own height and the image fills it, so the
         desktop 360px floor must not apply here. */
      height: 17rem;
      min-height: 0;
    }
  }
</style>
