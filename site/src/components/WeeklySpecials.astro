---
import { weeklySpecials } from '../data/restaurant';
---

<section class="specials" aria-labelledby="specials-title">
  <div class="wrap">
    <div class="specials__head">
      <p class="eyebrow" data-reveal="up">Weekly specials</p>
      <h2 class="display specials__h2" id="specials-title" data-reveal="up">Something every day</h2>
    </div>

    <ul class="specials__grid">
      {
        weeklySpecials.map((s, i) => (
          <li class="special" data-reveal="up" data-stagger={i}>
            <p class="special__day display">{s.day}</p>
            <h3 class="special__title display display--700">{s.title}</h3>
            <p class="special__body">{s.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .specials {
    background: var(--sand);
    padding-block: var(--sec-y);
  }

  .specials__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .specials__h2 {
    font-size: var(--t-h2);
  }

  .specials__grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .special {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-items: flex-start;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 1.75rem;
    transition: transform 0.45s var(--ease);
  }

  .special:hover {
    transform: translateY(-0.375rem);
  }

  .special__day {
    margin: 0;
    align-self: flex-start;
    padding: 0.5rem 0.875rem;
    background: var(--navy);
    color: var(--white);
    font-size: var(--t-22);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
  }

  .special__title {
    margin: 0;
    font-size: var(--t-30);
    line-height: 1;
  }

  .special__body {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  @media (max-width: 68.75rem) {
    .specials__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
