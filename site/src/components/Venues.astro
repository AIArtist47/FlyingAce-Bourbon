---
import { venues } from '../data/events';
---

<section class="ven section section--pad" id="venues" aria-labelledby="ven-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">Venues</p>
        <h2 class="display ven__h2" id="ven-title" data-reveal="up">Our event spaces</h2>
      </div>
      <p class="lede ven__aside" data-reveal="up">
        Four spaces on one farm. Walk three of them before you visit.
      </p>
    </div>

    {/* Alternating sides rather than a card grid: each space gets room for a
        real photograph and the detail that decides whether it suits. */}
    <div class="ven__list">
      {
        venues.map((v, i) => (
          <article class="venue" id={v.id} data-reveal="up" data-flip={i % 2 === 1}>
            <div class="venue__media">
              <img
                class="venue__img"
                src={v.image}
                alt={v.alt}
                width="980"
                height="653"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="venue__body">
              <h3 class="display display--700 venue__name">{v.name}</h3>
              <p class="venue__meta">{v.meta}</p>
              <p class="venue__text">{v.body}</p>
              {v.tour && (
                <a class="arrow-link venue__tour" href={v.tour} target="_blank" rel="noopener">
                  View 3D tour <span class="arrow-link__ico">&#8599;</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ven__h2 {
    font-size: var(--t-h2);
  }

  .ven__aside {
    margin: 0;
    max-width: 22rem;
  }

  .ven__list {
    margin-top: 3.5rem;
    display: grid;
    gap: 4rem;
  }

  .venue {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3rem;
    align-items: center;
  }

  /* Every other one leads with the words instead, so four spaces do not read
     as four identical rows. */
  .venue[data-flip='true'] .venue__media {
    order: 2;
  }

  .venue__media {
    aspect-ratio: 980 / 653;
    overflow: hidden;
    background: var(--sand);
    min-width: 0;
  }

  .venue__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 0.9s var(--ease);
  }

  .venue:hover .venue__img {
    transform: scale(1.04);
  }

  .venue__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    min-width: 0;
  }

  .venue__name {
    margin: 0;
    font-size: var(--t-34);
    line-height: 1;
  }

  .venue__meta {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  .venue__text {
    margin: 0.375rem 0 0;
    max-width: 46ch;
    font-size: var(--t-15);
    line-height: var(--lh-body);
    color: var(--muted);
  }

  .venue__tour {
    margin-top: 0.5rem;
  }

  @media (max-width: 68.75rem) {
    .ven__list {
      margin-top: 2.5rem;
      gap: 3rem;
    }

    .venue {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    /* Stacked, the picture always leads; the flip only means something when
       the two sit side by side. */
    .venue[data-flip='true'] .venue__media {
      order: 0;
    }

    .venue__name {
      font-size: var(--t-30);
    }
  }
</style>
