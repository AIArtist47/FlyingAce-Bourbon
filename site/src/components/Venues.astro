---
import { venues, venueStats } from '../data/events';

/**
 * Composition mirrored from the supplied reference: a centred pill and
 * heading, numbered cards, then a wide photograph with a dark figures panel
 * inset into it.
 *
 * The cards have since moved on from the reference's white box with a corner
 * thumbnail. Each is now the photograph itself, edge to edge, with the words
 * lifted onto a navy wash that rises out of the bottom of the frame.
 *
 * The reference's rounded corners are still not carried over: this site is
 * sharp-cornered throughout and rounding one section would break that.
 *
 * The outdoor spaces keep their entry in the data - the farm does have four
 * spaces, which is what the figure below counts - but no longer take a card
 * of their own, so the pair reads against one wide card rather than three.
 */
const shown = venues.filter((v) => v.id !== 'outdoors');
---

<section class="ven section section--pad" id="venues" aria-labelledby="ven-title">
  <div class="wrap">
    <div class="ven__head">
      <p class="ven__pill" data-reveal="up">
        <span class="ven__pip" aria-hidden="true"></span>
        Venues
      </p>
      <h2 class="display ven__h2" id="ven-title" data-reveal="up">Our event spaces</h2>
      <p class="ven__sub" data-reveal="up">
        Four spaces on one farm. Walk three of them before you visit.
      </p>
    </div>

    <ul class="ven__grid">
      {
        shown.map((v, i) => (
          <li
            class={`vcard${i > 1 ? ' vcard--wide' : ''}`}
            id={v.id}
            data-reveal="up"
            data-stagger={i % 2}
          >
            <img
              class="vcard__bg"
              src={v.image}
              alt={v.alt}
              width="980"
              height="653"
              loading="lazy"
              decoding="async"
            />
            <span class="vcard__scrim" aria-hidden="true" />

            <div class="vcard__content">
              <span class="vcard__num tnum">{String(i + 1).padStart(2, '0')}</span>

              <div class="vcard__body">
                <h3 class="display display--700 vcard__name">{v.name}</h3>
                <p class="vcard__meta">{v.meta}</p>
                <p class="vcard__text">{v.body}</p>
                {v.tour && (
                  <a class="vcard__tour tap-box" href={v.tour} target="_blank" rel="noopener">
                    View 3D tour <span class="arrow-link__ico">&#8599;</span>
                  </a>
                )}
              </div>
            </div>

            {/* The figures sit in the farmhouse card now rather than in a band
                of their own beneath it. The wide card had empty frame on its
                right and the band was a second picture saying the same thing. */}
            {v.id === 'farmhouse' && (
              <dl class="vstats">
                {venueStats.map((st) => (
                  <div class="vstat">
                    <dt class="vstat__label">{st.label}</dt>
                    <dd class="vstat__value display tnum">
                      {st.value}
                      {st.suffix && <span class="vstat__suffix">{st.suffix}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  /* --- Centred head ----------------------------------------------------- */

  .ven__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .ven__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4375rem 0.875rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .ven__pip {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--accent);
  }

  .ven__h2 {
    margin: 0;
    font-size: var(--t-h2);
  }

  .ven__sub {
    margin: 0;
    max-width: 34ch;
    font-size: var(--t-17);
    line-height: var(--lh-body);
    color: var(--muted);
  }

  /* --- Cards ------------------------------------------------------------ */

  .ven__grid {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .vcard {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* The photograph is the card now, so the ratio sets the height rather
       than the copy inside it. */
    aspect-ratio: 5 / 3;
    background: var(--navy);
  }

  .vcard--wide {
    grid-column: 1 / -1;
    aspect-ratio: 3 / 1;
  }

  .vcard__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1s var(--ease);
  }

  .vcard:hover .vcard__bg {
    transform: scale(1.07);
  }

  /* Navy rising out of the bottom of the frame, still clearing by the top so
     the picture reads as a picture. The stops carry the text's contrast, so
     they are set from it rather than by eye: checked against a worst case of
     pure white behind the glass, the title clears 6:1 and the small brass
     line 6:1, where before they sat at 3.2 and 3.8. */
  .vcard__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(24, 33, 44, 0.96) 0%,
      rgba(24, 33, 44, 0.94) 32%,
      rgba(24, 33, 44, 0.82) 48%,
      rgba(24, 33, 44, 0.38) 68%,
      rgba(24, 33, 44, 0.08) 86%,
      rgba(24, 33, 44, 0) 100%
    );
  }

  .vcard__content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem;
    color: var(--cream);
  }

  /* The number sits at the top, where the wash has all but cleared and a
     bright sky behind it left it at 1.8:1. Its own solid chip rather than a
     heavier wash over the whole picture. */
  .vcard__num {
    align-self: flex-start;
    padding: 0.3125rem 0.5rem;
    background: var(--navy);
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--brass);
  }

  .vcard__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }

  .vcard__name {
    margin: 0;
    font-size: var(--t-34);
    line-height: 1;
    color: var(--cream);
  }

  .vcard__meta {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--brass);
  }

  .vcard__text {
    margin: 0.25rem 0 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--on-navy);
  }

  /* Stops short of the figures rather than running beneath them. */
  .vcard--wide .vcard__text {
    max-width: 46ch;
  }

  .vcard__tour {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 238, 227, 0.4);
    padding-bottom: 0.25rem;
    transition:
      color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .vcard__tour .arrow-link__ico {
    transition: transform 0.35s var(--ease);
  }

  .vcard__tour:hover {
    color: var(--brass);
    border-bottom-color: var(--brass);
  }

  .vcard__tour:hover .arrow-link__ico {
    transform: translate(0.125rem, -0.125rem);
  }

  /* Seated in the farmhouse card's bottom-right, clear of the words on
     the left. */
  .vstats {
    position: absolute;
    z-index: 3;
    right: 1.5rem;
    bottom: 1.5rem;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    /* The card's wash is already near-solid navy down here, so the panel
       needs an edge to read as a panel rather than as a darker patch. */
    background: var(--navy);
    border: 1px solid var(--rule-navy);
    color: var(--cream);
  }

  .vstat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    padding: 1.5rem 2rem;
  }

  .vstat + .vstat {
    border-left: 1px solid var(--rule-navy);
  }

  .vstat__value {
    margin: 0;
    font-size: var(--t-44);
    line-height: 1;
    color: var(--cream);
  }

  /* The suffix picks up the accent, the way the reference's "+" and "k" do.
     Brass rather than the red: on navy the red is close to invisible, which is
     why the focus rings on dark surfaces already switch to brass. */
  .vstat__suffix {
    color: var(--brass);
  }

  .vstat__label {
    margin: 0;
    font-size: var(--t-13);
    color: var(--on-navy-3);
  }

  /* --- Narrow ----------------------------------------------------------- */

  @media (max-width: 68.75rem) {
    .ven__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.5rem;
    }

    /* One column, so the wide one stops being wide. The ratio goes with it:
       at 335px a 4:3 card is 251px tall and the copy needs up to 337, which
       the card's own overflow was quietly cutting off. The content sets the
       height here and the picture, being absolutely placed, fills whatever
       that turns out to be. */
    .vcard,
    .vcard--wide {
      aspect-ratio: auto;
      min-height: 17rem;
    }

    .vcard__name {
      font-size: var(--t-30);
    }

    /* No width to float in, so the figures join the flow under the words.
       The card becomes a column for it, since the content block is sized to
       the card and a static sibling would otherwise sit on top of it. */
    .vcard--wide {
      display: flex;
      flex-direction: column;
    }

    .vcard--wide .vcard__content {
      flex: 1 1 auto;
      height: auto;
    }

    .vstats {
      position: static;
      grid-auto-flow: row;
      margin: 0 1.5rem 1.5rem;
    }

    .vstat + .vstat {
      border-left: 0;
      border-top: 1px solid var(--rule-navy);
    }

    .vstat {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }
  }
</style>
