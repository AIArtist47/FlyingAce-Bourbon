---
import { venues, venueStats, venueFeature } from '../data/events';

/**
 * Composition mirrored from the supplied reference: a centred pill and
 * heading, numbered cards each carrying a thumbnail in the opposite corner,
 * then a wide photograph with a dark figures panel inset into it.
 *
 * The reference's own palette and its rounded corners are not carried over.
 * This site is sharp-cornered throughout and rounding one section would break
 * that; the colours come from the farm's own tokens, which already sit in the
 * same cream-ground / white-card / warm-accent relationship.
 */
---

<section class="ven section section--pad" id="venues" aria-labelledby="ven-title">
  <div class="wrap">
    <div class="ven__head">
      <p class="ven__pill" data-reveal="up">
        <span class="ven__pip" aria-hidden="true"></span>
        Venues
      </p>
      <h2 class="display ven__h2" id="ven-title" data-reveal="up">Our event spaces</h2>
      <p class="ven__sub" data-reveal="up">
        Four spaces on one farm. Walk three of them before you visit.
      </p>
    </div>

    <ul class="ven__grid">
      {
        venues.map((v, i) => (
          <li class="vcard" id={v.id} data-reveal="up" data-stagger={i % 2}>
            <div class="vcard__top">
              <span class="vcard__num tnum">{String(i + 1).padStart(2, '0')}</span>
              <span class="vcard__thumb">
                <img
                  class="vcard__img"
                  src={v.image}
                  alt={v.alt}
                  width="208"
                  height="208"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </div>

            <div class="vcard__body">
              <h3 class="display display--700 vcard__name">{v.name}</h3>
              <p class="vcard__meta">{v.meta}</p>
              <p class="vcard__text">{v.body}</p>
              {v.tour && (
                <a class="arrow-link vcard__tour" href={v.tour} target="_blank" rel="noopener">
                  View 3D tour <span class="arrow-link__ico">&#8599;</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="ven__feature" data-reveal="up">
      <img
        class="ven__featureimg"
        src={venueFeature.image}
        alt={venueFeature.alt}
        width="980"
        height="653"
        loading="lazy"
        decoding="async"
      />

      <dl class="vstats">
        {
          venueStats.map((s) => (
            <div class="vstat">
              <dt class="vstat__label">{s.label}</dt>
              <dd class="vstat__value display tnum">
                {s.value}
                {s.suffix && <span class="vstat__suffix">{s.suffix}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* --- Centred head ----------------------------------------------------- */

  .ven__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .ven__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.4375rem 0.875rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .ven__pip {
    width: 0.625rem;
    height: 0.625rem;
    background: var(--accent);
  }

  .ven__h2 {
    margin: 0;
    font-size: var(--t-h2);
  }

  .ven__sub {
    margin: 0;
    max-width: 34ch;
    font-size: var(--t-17);
    line-height: var(--lh-body);
    color: var(--muted);
  }

  /* --- Cards ------------------------------------------------------------ */

  .ven__grid {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .vcard {
    display: flex;
    flex-direction: column;
    /* The reference's own proportion: the number and thumbnail sit at the top,
       a deliberate hole of space, then the words at the bottom. */
    justify-content: space-between;
    gap: 4.5rem;
    min-height: 21rem;
    padding: 1.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    transition:
      border-color 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .vcard:hover {
    border-color: var(--accent);
    transform: translateY(-0.25rem);
  }

  .vcard__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .vcard__num {
    font-size: var(--t-13);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--accent);
  }

  .vcard__thumb {
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    overflow: hidden;
    background: var(--sand);
    flex: none;
  }

  .vcard__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 0.9s var(--ease);
  }

  .vcard:hover .vcard__img {
    transform: scale(1.07);
  }

  .vcard__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .vcard__name {
    margin: 0;
    font-size: var(--t-34);
    line-height: 1;
  }

  .vcard__meta {
    margin: 0;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .vcard__text {
    margin: 0.375rem 0 0;
    max-width: 48ch;
    font-size: var(--t-15);
    line-height: var(--lh-body);
    color: var(--muted);
  }

  .vcard__tour {
    margin-top: 0.375rem;
  }

  /* --- Feature with the figures panel ----------------------------------- */

  .ven__feature {
    position: relative;
    margin-top: 1.25rem;
    overflow: hidden;
  }

  /* The reference's band is about 3.5:1 - a letterbox strip rather than a
     picture, which is what lets the figures panel sit over it without
     burying anything. */
  .ven__featureimg {
    display: block;
    width: 100%;
    aspect-ratio: 24 / 7;
    object-fit: cover;
  }

  /* Inset from the picture's bottom-right corner, not flush to it, which is
     how the reference holds it clear of the frame. */
  .vstats {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    background: var(--navy);
    color: var(--cream);
  }

  .vstat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    padding: 1.5rem 2rem;
  }

  .vstat + .vstat {
    border-left: 1px solid var(--rule-navy);
  }

  .vstat__value {
    margin: 0;
    font-size: var(--t-44);
    line-height: 1;
    color: var(--cream);
  }

  /* The suffix picks up the accent, the way the reference's "+" and "k" do.
     Brass rather than the red: on navy the red is close to invisible, which is
     why the focus rings on dark surfaces already switch to brass. */
  .vstat__suffix {
    color: var(--brass);
  }

  .vstat__label {
    margin: 0;
    font-size: var(--t-13);
    color: var(--on-navy-3);
  }

  /* --- Narrow ----------------------------------------------------------- */

  @media (max-width: 68.75rem) {
    .ven__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.5rem;
    }

    .vcard {
      min-height: 0;
      gap: 2rem;
    }

    .ven__featureimg {
      aspect-ratio: 16 / 10;
    }

    /* The panel stops floating once there is no width to float in. */
    .vstats {
      position: static;
      grid-auto-flow: row;
    }

    .vstat + .vstat {
      border-left: 0;
      border-top: 1px solid var(--rule-navy);
    }

    .vstat {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }
  }
</style>
