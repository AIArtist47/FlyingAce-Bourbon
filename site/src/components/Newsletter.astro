---

---

<section class="newsletter" aria-labelledby="news-title">
  <div class="newsletter__inner wrap">
    <div class="newsletter__copy">
      <h2 class="display newsletter__h2" id="news-title" data-reveal="up">Be the first to know</h2>
      <p class="newsletter__lede" data-reveal="up">
        Email updates on special events and offers you can redeem at the farm.
      </p>
    </div>

    <form class="signup" data-signup novalidate data-reveal="up">
      <div class="signup__field">
        <label class="signup__label" for="su-name">First name</label>
        <input
          class="signup__input signup__input--name"
          id="su-name"
          name="firstName"
          type="text"
          autocomplete="given-name"
          required
        />
      </div>

      <div class="signup__field">
        <label class="signup__label" for="su-email">Email</label>
        <input
          class="signup__input signup__input--email"
          id="su-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          aria-describedby="su-status"
        />
      </div>

      <button class="btn btn--navy btn--lg signup__btn" type="submit">Sign Up</button>

      <p class="signup__status" id="su-status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<style>
  .newsletter {
    background: var(--accent);
    color: var(--white);
  }

  .newsletter__inner {
    min-height: 20rem; /* 320px */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    flex-wrap: wrap;
    padding-block: var(--sec-y);
  }

  .newsletter__copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 32.5rem; /* 520px */
    min-width: 0;
  }

  .newsletter__h2 {
    font-size: var(--t-h2-news);
  }

  .newsletter__lede {
    font-size: var(--t-17);
    line-height: var(--lh-body);
    color: var(--white);
  }

  .signup {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    flex-wrap: wrap;
    position: relative;
  }

  .signup__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .signup__label {
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .signup__input {
    min-height: 3.25rem; /* 52px */
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0 1rem;
    font-size: var(--t-16);
    font-family: inherit;
    background: var(--white);
    color: var(--ink);
    transition: border-color 0.3s var(--ease);
  }

  .signup__input--name {
    width: 12.5rem; /* 200px */
  }

  .signup__input--email {
    width: 18.75rem; /* 300px */
  }

  .signup__input[aria-invalid='true'] {
    border-bottom-color: var(--navy);
  }

  .signup__btn {
    flex-shrink: 0;
  }

  .signup__status {
    flex-basis: 100%;
    min-height: 1.5rem;
    font-size: var(--t-14);
    font-weight: 600;
    margin: 0;
  }

  .signup.is-done .signup__field,
  .signup.is-done .signup__btn {
    display: none;
  }

  .signup.is-done .signup__status {
    font-size: var(--t-17);
  }

  @media (max-width: 30rem) {
    .signup,
    .signup__field {
      width: 100%;
    }
    .signup__input--name,
    .signup__input--email {
      width: 100%;
    }
    .signup__btn {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-signup]');
  const status = document.querySelector<HTMLParagraphElement>('[data-status]');

  if (form && status) {
    const name = form.querySelector<HTMLInputElement>('#su-name')!;
    const email = form.querySelector<HTMLInputElement>('#su-email')!;

    const clear = (el: HTMLInputElement) => {
      el.removeAttribute('aria-invalid');
      status.textContent = '';
    };
    name.addEventListener('input', () => clear(name));
    email.addEventListener('input', () => clear(email));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      name.removeAttribute('aria-invalid');
      email.removeAttribute('aria-invalid');

      if (!name.value.trim()) {
        name.setAttribute('aria-invalid', 'true');
        status.textContent = 'Please add your first name.';
        name.focus();
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim())) {
        email.setAttribute('aria-invalid', 'true');
        status.textContent = 'Please enter a valid email address.';
        email.focus();
        return;
      }

      // No list provider is wired up yet - the build notes route this to the
      // farm's CRM. Until then the form confirms locally and keeps the value.
      form.classList.add('is-done');
      status.textContent = `Thanks, ${name.value.trim()} - you’re on the list.`;
    });
  }
</script>
