---
import { tastingRoomHours, goodToKnow } from '../data/distillery';
import { site } from '../data/site';
---

<section class="troom section section--pad" id="tasting-hours" aria-labelledby="troom-title">
  <div class="wrap troom__grid">
    <div class="troom__col">
      <h2 class="display troom__h2" id="troom-title" data-reveal="up">Tasting room hours</h2>
      <dl class="troom__hours" data-reveal="up">
        {
          tastingRoomHours.map((h) => (
            <div class="troom__row">
              <dt>{h.day}</dt>
              <dd>{h.time}</dd>
            </div>
          ))
        }
      </dl>
      <a class="arrow-link" href={site.directions} target="_blank" rel="noopener" data-reveal="up">
        Get directions <span class="arrow-link__ico">&#8594;</span>
      </a>
    </div>

    <div class="troom__col">
      <h2 class="display troom__h2" data-reveal="up">Good to know</h2>
      <div class="troom__notes">
        {
          goodToKnow.map((n, i) => (
            <div class="note" data-reveal="up" data-stagger={i}>
              <h3 class="note__title display display--700">{n.title}</h3>
              <p class="note__body">{n.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .troom {
    border-top: 1px solid var(--rule);
  }

  .troom__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .troom__col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    min-width: 0;
  }

  .troom__h2 {
    font-size: var(--t-h2-sm);
  }

  .troom__hours {
    margin: 0;
    width: 100%;
  }

  .troom__row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-17);
  }

  .troom__row dt {
    margin: 0;
    font-weight: 600;
  }

  .troom__row dd {
    margin: 0;
    text-align: right;
    color: var(--muted);
  }

  .troom__notes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .note {
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.45s var(--ease);
  }

  .note:hover {
    border-color: var(--accent);
  }

  .note__title {
    font-size: var(--t-26);
    line-height: 1;
    margin: 0;
  }

  .note__body {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  @media (max-width: 68.75rem) {
    .troom__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
