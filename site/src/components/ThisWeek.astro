---
import Icon from './Icon.astro';
import { week } from '../data/site';
---

<section class="week section section--pad" id="this-week" aria-labelledby="week-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-head__title">
        <p class="eyebrow" data-reveal="up">Weekly at the farm</p>
        <h2 class="display week__h2" id="week-title" data-reveal="up">This week at Flying Ace</h2>
      </div>
      <a class="arrow-link" href="https://flyingacefarm.com/?page_id=1517" data-reveal="up">
        Full calendar <span class="arrow-link__ico">&#8594;</span>
      </a>
    </div>

    <div class="week__grid">
      {
        week.map((d, i) => (
          <article class="day" data-reveal="up" data-stagger={i}>
            <p class={`day__chip display${d.accent ? ' day__chip--accent' : ''}`}>{d.day}</p>
            <h3 class="day__title display display--700">{d.title}</h3>
            <p class="day__body">{d.body}</p>
            <p class="day__time">{d.time}</p>
          </article>
        ))
      }
    </div>

    <div class="upnext" data-reveal="up">
      <div class="upnext__left">
        <Icon name="calendar" size={24} stroke="var(--brass)" />
        <span class="kicker">Coming up</span>
        <span class="upnext__name display display--700">Oktoberfest Brunch</span>
      </div>
      <a class="btn btn--solid" href="https://flyingacefarm.com/?page_id=1517">Get Tickets</a>
    </div>
  </div>
</section>

<style>
  .week__h2 {
    font-size: var(--t-h2);
  }

  .week__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .day {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: 1.75rem;
    min-height: 18.75rem; /* 300px */
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .day:hover {
    transform: translateY(-0.375rem);
    border-color: var(--accent);
    box-shadow: 0 24px 40px -32px rgba(24, 33, 44, 0.55);
  }

  .day__chip {
    align-self: flex-start;
    padding: 0.5rem 0.875rem;
    background: var(--navy);
    color: var(--white);
    font-size: var(--t-22);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
  }

  .day__chip--accent {
    background: var(--accent);
  }

  .day__title {
    font-size: var(--t-30);
    line-height: 1;
  }

  .day__body {
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  .day__time {
    font-size: var(--t-14);
    font-weight: 600;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .upnext {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: var(--navy);
    color: var(--cream);
    padding: 1rem 1.75rem;
    min-height: 4.75rem; /* 76px */
  }

  .upnext__left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .upnext__name {
    font-size: var(--t-26);
  }

  @media (max-width: 68.75rem) {
    .week__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .week__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .day {
      min-height: 0;
    }
  }
</style>
