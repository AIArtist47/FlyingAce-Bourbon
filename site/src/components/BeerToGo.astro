---
import { beerToGo } from '../data/brewery';
---

<section class="togo" id="to-go" aria-labelledby="togo-title">
  <div class="wrap">
    <div class="togo__head">
      <p class="eyebrow" data-reveal="up">Travel size</p>
      <h2 class="display togo__h2" id="togo-title" data-reveal="up">Beer to go</h2>
    </div>

    <div class="togo__grid">
      {
        beerToGo.map((item, i) => (
          <article class="pack" data-reveal="up" data-stagger={i}>
            <span class="pack__media">
              <img class="pack__img" src={item.image} alt={item.alt} loading="lazy" />
            </span>
            <div class="pack__body">
              <h3 class="pack__title display">{item.title}</h3>
              <p class="pack__price">{item.price}</p>
              <p class="pack__note">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .togo {
    background: var(--sand);
    padding-block: var(--sec-y);
  }

  .togo__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .togo__h2 {
    font-size: var(--t-h2);
  }

  .togo__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .pack {
    display: flex;
    align-items: stretch;
    gap: 0;
    background: var(--paper);
    border: 1px solid var(--rule);
    transition:
      border-color 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  .pack:hover {
    border-color: var(--accent);
    transform: translateY(-0.375rem);
  }

  .pack__media {
    display: block;
    width: 18.75rem; /* 300px */
    flex-shrink: 0;
    overflow: hidden;
  }

  .pack__img {
    width: 100%;
    height: 100%;
    min-height: 20rem; /* 320px */
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .pack:hover .pack__img {
    transform: scale(1.05);
  }

  .pack__body {
    flex-grow: 1;
    min-width: 0;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.625rem;
  }

  .pack__title {
    margin: 0;
    font-size: var(--t-34);
    line-height: 1;
  }

  .pack__price {
    margin: 0;
    font-size: var(--t-lead);
    font-weight: 700;
    color: var(--accent);
  }

  .pack__note {
    margin: 0;
    font-size: var(--t-15);
    line-height: var(--lh-tight);
    color: var(--muted);
  }

  @media (max-width: 68.75rem) {
    .togo__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 36rem) {
    .pack {
      flex-direction: column;
    }
    .pack__media {
      width: 100%;
    }
    .pack__img {
      min-height: 0;
      height: 15rem;
    }
    .pack__body {
      padding: 1.75rem;
    }
  }
</style>
