---
import { faqs } from '../data/visit';
---

<section class="faq section section--pad" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__inner">
    <div class="faq__head">
      <p class="eyebrow" data-reveal="up">Frequently asked</p>
      <h2 class="display faq__h2" id="faq-title" data-reveal="up">Questions</h2>
      <p class="faq__lede sub__body" data-reveal="up">
        Still stuck? Call us on the number above, or email
        <a href="mailto:events@flyingacefarm.com">events@flyingacefarm.com</a>.
      </p>
    </div>

    {/* <details> rather than a scripted accordion: it opens and closes, takes
        focus and answers the keyboard on its own, it is findable by the
        browser's own in-page search even while closed, and it still works if
        the script never arrives. */}
    <div class="faq__list">
      {
        faqs.map((f, i) => (
          <details class="qa" name="faq" data-reveal="up" data-stagger={i % 3}>
            <summary class="qa__q">
              <span class="qa__text">{f.q}</span>
              <span class="qa__sign" aria-hidden="true" />
            </summary>
            <div class="qa__a">
              <p class="qa__body">{f.a}</p>
              {f.link && (
                <a
                  class="arrow-link qa__link"
                  href={f.link.href}
                  target={f.link.external ? '_blank' : undefined}
                  rel={f.link.external ? 'noopener' : undefined}
                >
                  {f.link.text} <span class="arrow-link__ico">&#8594;</span>
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .faq__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 7rem;
  }

  .faq__h2 {
    font-size: var(--t-h2);
  }

  .faq__lede {
    margin: 0.5rem 0 0;
    font-size: var(--t-body-sm);
    line-height: var(--lh-body);
    color: var(--muted);
    max-width: 32ch;
  }

  /* --- One question ----------------------------------------------------- */

  .qa {
    border-top: 1px solid var(--rule);
  }

  .qa:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .qa__q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.375rem 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.35s var(--ease);
  }

  /* The UA's own marker, in both spellings. */
  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__q::marker {
    content: '';
  }

  .qa__text {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 600;
    font-size: var(--t-22);
    line-height: var(--lh-card);
    letter-spacing: var(--ls-caps-sm);
    min-width: 0;
  }

  .qa__q:hover {
    color: var(--accent);
  }

  /* A plus that becomes a minus. Drawn in CSS rather than swapped for a second
     icon, so there is one thing on screen rotating rather than two crossfading. */
  .qa__sign {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    align-self: center;
  }

  .qa__sign::before,
  .qa__sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }

  .qa__sign::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__sign::after {
    transform: rotate(0deg);
  }

  .qa__a {
    padding: 0 0 1.5rem;
    max-width: 62ch;
  }

  .qa__body {
    margin: 0;
    font-family: var(--font-sub);
    font-weight: 500;
    font-size: var(--t-body-sm);
    line-height: var(--lh-body);
    color: var(--muted);
  }

  .qa__link {
    margin-top: 0.875rem;
  }

  @media (max-width: 60rem) {
    .faq__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Nothing to stay beside once it is one column. */
    .faq__head {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa__sign::before,
    .qa__sign::after {
      transition: none;
    }
  }
</style>
