# Mail for the inquiry form on /host-your-event and /weddings.
#
# Set ONE of the two groups below, in the Vercel project (Production and
# Preview) and in a local .env.local for development. Until one is set, the
# endpoint says plainly that it could not send and gives the visitor the inbox
# to write to -- nothing fails silently, but nothing reaches the farm either.
#
# ---------------------------------------------------------------------------
# 1. The farm's own mailbox, over SMTP. Nothing to sign up for: these are the
#    credentials for a mailbox that already exists on flyingacefarm.com. Ask
#    whoever hosts the domain's mail for the outgoing server and port.
#    Port 587 is the usual one and upgrades to TLS; 465 is TLS from the start.
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# 2. Or Resend, if you would rather not put mailbox credentials on the server.
#    Create an account at resend.com, add flyingacefarm.com as a domain (which
#    means adding the DNS records it shows you), then make an API key with
#    Sending access.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Both routes use this as the sender. It must be an address the route above is
# allowed to send as: the mailbox itself for SMTP, or an address at the
# verified domain for Resend. It is the sender only -- replies go to whoever
# filled in the form.
# ---------------------------------------------------------------------------

ENQUIRY_FROM="Flying Ace Farm <inquiries@flyingacefarm.com>"
